+// NextClave (NC_AWG): strict allowlist of AmneziaWG device-level parameters
+// (amneziawg-go device/uapi.go, protocol 3.1), normalized (lowercase, no
+// "_"/"-") to canonical UAPI keys, so AmneziaWG .conf spellings
+// ("HeaderProtectionKey"), UAPI spellings ("header_protection_key") and
+// mihomo yaml spellings are all accepted and emitted canonically. Unknown
+// keys are rejected so a hostile config cannot smuggle
+// private_key/endpoint/peer directives into the wireguard IPC stream through
+// the awgParams field.
+var awgCanonicalKeys = map[string]string{
+	"jc": "jc", "jmin": "jmin", "jmax": "jmax",
+	"s1": "s1", "s2": "s2", "s3": "s3", "s4": "s4",
+	"h1": "h1", "h2": "h2", "h3": "h3", "h4": "h4",
