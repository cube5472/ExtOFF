+	"headerprotectionkey":    "header_protection_key",
+	"contentpaddingaddition": "content_padding_addition",
+	"rekeyaftertime":         "rekey_after_time",
+	"rekeytimeout":           "rekey_timeout",
+	"rejectaftertime":        "reject_after_time",
+	"keepalivetimeout":       "keepalive_timeout",
+	"maxhandshakeattempts":   "max_handshake_attempts",
+	"randomtrailers":         "random_trailers",
+	"disablecookies":         "disable_cookies",
+}
+
+func normalizeAWGKey(key string) string {
+	return strings.ReplaceAll(strings.ReplaceAll(strings.ToLower(key), "_", ""), "-", "")
+}
+
+// parseAWGParams normalizes the raw block into lowercase canonical
+// "key=value" UAPI lines for createIPCRequest (proxy/wireguard/wireguard.go).
+// Value formats mirror amneziawg-go's parsing: jc/jmin/jmax/s1-s4 take small
+// unsigned integers; h1-h4 and the timeout keys take an unsigned integer or
+// an "a-b" range (UintRange); header_protection_key takes 64 hex chars
+// (32 bytes); random_trailers/disable_cookies take a bool; i1-i5 take the
+// CPS description string verbatim.
+func parseAWGParams(raw string) ([]string, error) {
+	var params []string
+	for i, line := range strings.Split(raw, "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" || strings.HasPrefix(line, "#") {
+			continue
+		}
+		idx := strings.IndexAny(line, "=:")
+		if idx < 0 {
+			return nil, newError("invalid AmneziaWG param at line ", i+1, ": ", line)
+		}
+		canonical, ok := awgCanonicalKeys[normalizeAWGKey(strings.TrimSpace(line[:idx]))]
+		if !ok {
+			return nil, newError("unknown AmneziaWG param: ", strings.TrimSpace(line[:idx]))
+		}
+		value := strings.TrimSpace(line[idx+1:])
+		if err := validateAWGValue(canonical, value); err != nil {
+			return nil, err
+		}
+		params = append(params, canonical+"="+value)
+	}
+	if len(params) > 64 {
+		return nil, newError("too many AmneziaWG params")
+	}
+	return params, nil
+}
+
+func validateAWGValue(key, value string) error {
+	if value == "" {
+		return newError("empty value for AmneziaWG param ", key)
+	}
+	switch key {
+	case "header_protection_key":
+		// NextClave (NC_AWG): amneziawg-go v3.1 parses this value with
+		// HeaderCipherKey.FromHex (loadExactHex into a [32]byte key), so it
+		// is exactly 64 hex chars; the previous 32-hex check rejected valid
+		// provider configs at connect time ("must be 32 hex chars").
+		if len(value) != 64 {
+			return newError("header_protection_key must be 64 hex chars (32 bytes)")
+		}
+		if _, err := hex.DecodeString(value); err != nil {
+			return newError("invalid header_protection_key hex value")
+		}
+	case "random_trailers", "disable_cookies":
+		if _, err := strconv.ParseBool(value); err != nil {
+			return newError("invalid bool value for AmneziaWG param ", key)
+		}
+	case "jc", "jmin", "jmax":
+		// NextClave (NC_AWG): bit sizes mirror amneziawg-go device/uapi.go
+		// exactly (32 for junk counts, 16 for s1-s4) so this pre-validation is
+		// never stricter than the authoritative IpcSet parsing. Same for the
+		// CPS strings below: no length cap, real provider chains are long.
+		if _, err := strconv.ParseUint(value, 10, 32); err != nil {
+			return newError("invalid unsigned value for AmneziaWG param ", key)
+		}
+	case "s1", "s2", "s3", "s4":
+		if _, err := strconv.ParseUint(value, 10, 16); err != nil {
+			return newError("invalid unsigned value for AmneziaWG param ", key)
+		}
+	case "i1", "i2", "i3", "i4", "i5":
+		// The CPS syntax itself is validated by amneziawg-go's newObfChain at
+		// IpcSet; locally only forbid breaking out of the single UAPI line.
+		if strings.ContainsAny(value, "\n\r\x00") {
+			return newError("invalid CPS string for AmneziaWG param ", key)
+		}
+	default:
+		// h1-h4 and the timeout/range keys: "uint" or "uint-uint"; UintRange
+		// in amneziawg-go is uint64, so parse with bitSize 64.
+		values := []string{value}
+		if strings.Contains(value, "-") {
+			values = strings.Split(value, "-")
+			if len(values) != 2 {
+				return newError("invalid range value for AmneziaWG param ", key)
+			}
+		}
+		for _, v := range values {
+			if _, err := strconv.ParseUint(strings.TrimSpace(v), 10, 64); err != nil {
+				return newError("invalid value for AmneziaWG param ", key)
+			}
+		}
+	}
+	return nil
+}
