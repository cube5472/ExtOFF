+// writeLengthFragment sends one fragment as its own TLS record (the first
+// three header bytes of the original record plus a per-fragment length, like
+// the splitRecord path). With disorder enabled the very first fragment is
+// sent with a tiny TTL instead, so it dies before reaching DPI and is
+// retransmitted by the kernel with the restored TTL (see the SNI-label
+// disorder mode). Final fragments are written without the ACK wait.
+func (c *tlsFragmentConn) writeLengthFragment(b []byte, frag []byte, fragIdx int, isLast bool) error {
+	var buffer bytes.Buffer
+	buffer.Write(b[:3])
+	binary.Write(&buffer, binary.BigEndian, uint16(len(frag)))
+	buffer.Write(frag)
+
+	fromMs, toMs := rangeAt(c.delays, fragIdx)
+	pauseMs := int(fromMs)
+	if spanMs := int(toMs) - int(fromMs); spanMs > 0 {
+		pauseMs += rand.Intn(spanMs + 1)
+	}
+
+	if !isLast && c.disorder && c.tcpConn != nil && fragIdx == 0 {
+		if restore, ok := setSocketTTL(c.tcpConn, c.ttl); ok {
+			if _, err := c.Conn.Write(buffer.Bytes()); err != nil {
+				restore()
+				return err
+			}
+			// give the dying packet ~10ms to leave the host before the
+			// TTL is restored
+			select {
+			case <-c.ctx.Done():
+				restore()
+				return c.ctx.Err()
+			case <-time.After(10 * time.Millisecond):
+			}
+			restore()
+			select {
+			case <-c.ctx.Done():
+				return c.ctx.Err()
+			case <-time.After(time.Millisecond * time.Duration(pauseMs)):
+			}
+			return nil
+		}
+	}
+
+	if !isLast && c.tcpConn != nil {
+		return writeAndWaitAck(c.ctx, c.tcpConn, buffer.Bytes(), time.Millisecond*time.Duration(pauseMs))
+	}
+	if _, err := c.Conn.Write(buffer.Bytes()); err != nil {
+		return err
+	}
+	if !isLast {
+		select {
+		case <-c.ctx.Done():
+			return c.ctx.Err()
+		case <-time.After(time.Millisecond * time.Duration(pauseMs)):
+		}
+	}
+	return nil
+}
+
+// rangeAt returns the from/to pair at index i; the last pair keeps applying
+// to all subsequent fragments. Missing specs degrade to (0, 0).
+func rangeAt(specs []int32, i int) (int32, int32) {
+	if len(specs) < 2 {
+		return 0, 0
+	}
+	idx := i * 2
+	if idx+1 >= len(specs) {
+		idx = len(specs) - 2
+	}
+	return specs[idx], specs[idx+1]
+}
