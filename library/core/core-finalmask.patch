+// writeByLengths fragments the first TLS record (the ClientHello) into
+// fragments sized from the flattened Int32Range pairs in lengths (bytes),
+// paced by delays (milliseconds); the last entry of each list keeps applying
+// to all subsequent fragments, mirroring the Xray finalmask "fragment" mask.
+// Every fragment is re-encapsulated as its own TLS record (the fm "tlshello"
+// behaviour) and written as a separate TCP segment; each non-final write
+// waits for the ACK like the SNI-label mode does.
+func (c *tlsFragmentConn) writeByLengths(b []byte) (int, error) {
+	if c.tcpConn != nil {
+		c.tcpConn.SetNoDelay(true)
+	}
+	payload := b[recordLayerHeaderLen:]
+	pos := 0
+	for fragIdx := 0; pos < len(payload); fragIdx++ {
+		if fragIdx == 256 {
+			// hard cap: flush the remainder as one final fragment instead of
+			// looping forever on a degenerate (e.g. 1-1) length spec
+			if err := c.writeLengthFragment(b, payload[pos:], fragIdx, true); err != nil {
+				return 0, err
+			}
+			return len(b), nil
+		}
+		from, to := rangeAt(c.lengths, fragIdx)
+		size := int(from)
+		if size < 1 {
+			size = 1
+		}
+		if span := int(to) - int(from); span > 0 {
+			size += rand.Intn(span + 1)
+		}
+		remaining := len(payload) - pos
+		if size > remaining {
+			size = remaining
+		}
+		if err := c.writeLengthFragment(b, payload[pos:pos+size], fragIdx, size == remaining); err != nil {
+			return 0, err
+		}
+		pos += size
+	}
+	return len(b), nil
