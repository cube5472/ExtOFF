+// parseRangeSpecs flattens Int32Range strings ("10-20", "50") into from/to
+// pairs, clamped to [minV, maxV]. Unparsable entries are dropped so a bad
+// panel-side mask can never break the whole socket config.
+func parseRangeSpecs(singular string, list []string, minV, maxV int32) []int32 {
+	specs := list
+	if len(specs) == 0 && strings.TrimSpace(singular) != "" {
+		specs = []string{singular}
+	}
+	var out []int32
+	for _, spec := range specs {
+		spec = strings.TrimSpace(spec)
+		if spec == "" {
+			continue
+		}
+		var from, to int64
+		if idx := strings.IndexByte(spec, '-'); idx > 0 {
+			a, err1 := strconv.ParseInt(strings.TrimSpace(spec[:idx]), 10, 32)
+			b, err2 := strconv.ParseInt(strings.TrimSpace(spec[idx+1:]), 10, 32)
+			if err1 != nil || err2 != nil {
+				continue
+			}
+			from, to = a, b
+		} else {
+			v, err := strconv.ParseInt(spec, 10, 32)
+			if err != nil {
+				continue
+			}
+			from, to = v, v
+		}
+		if from < int64(minV) {
+			from = int64(minV)
+		}
+		if to < from {
+			to = from
+		}
+		if to > int64(maxV) {
+			to = int64(maxV)
+		}
+		if from > int64(maxV) {
+			from = int64(maxV)
+		}
+		out = append(out, int32(from), int32(to))
+	}
+	return out
+}
