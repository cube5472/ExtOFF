@@ -16,12 +16,34 @@
 	"context"
 	"net/http"
 	"net/url"
+	"strings"
 
 	"github.com/quic-go/quic-go/http3"
 )
 
 const requestProtocol = "connect-ip"
 
+// NextClave (NC_MASQUE): Cloudflare WARP MASQUE dialect. The CF endpoint
+// expects :protocol "cf-connect-ip" and skips the RFC extended-CONNECT
+// settings handshake (mihomo/usque parity, which dial the WARP CONNECT-IP
+// tunnel at https://cloudflareaccess.com). The dialect is selected purely by
+// the request URI host, so the default RFC 9298 behavior is unchanged.
+const cfRequestProtocol = "cf-connect-ip"
+const cfWarpRequestHost = "cloudflareaccess.com"
+
+func requestProtocolForURL(u *url.URL) string {
+	if u != nil && strings.EqualFold(u.Host, cfWarpRequestHost) {
+		return cfRequestProtocol
+	}
+	return requestProtocol
+}
+
+// IsWarpRequestURL reports whether the CONNECT-IP request targets the
+// Cloudflare WARP MASQUE service.
+func IsWarpRequestURL(u *url.URL) bool {
+	return requestProtocolForURL(u) == cfRequestProtocol
+}
+
 var capsuleProtocolHeaderValue = "?1"
 
 type Request struct {
