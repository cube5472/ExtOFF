diff -ruN core-patched.awgbase/proxy/masque/internal/connectip/request.go core-patched/proxy/masque/internal/connectip/request.go
--- core-patched.awgbase/proxy/masque/internal/connectip/request.go	2026-11-15 05:14:54.945481273 +0000
