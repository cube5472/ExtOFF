--- a/transport/internet/xdrive/local_windows.go	1970-01-01 00:00:00.000000000 +0000
+++ b/transport/internet/xdrive/local_windows.go	2026-11-24 19:03:30.388755568 +0000
@@ -0,0 +1,30 @@
+package xdrive
+
+import (
+	"context"
+	"errors"
+	"os"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+// readFile retries os.ReadFile for up to 2 seconds on sharing violations:
+// os.Rename (MoveFileEx) in Put holds the file with DELETE access, which
+// os.ReadFile does not share, until a moment after its new name appears in List
+func readFile(ctx context.Context, name string) ([]byte, error) {
+	deadline := time.Now().Add(2 * time.Second)
+	delay := time.Millisecond
+	for {
+		data, err := os.ReadFile(name)
+		if !errors.Is(err, windows.ERROR_SHARING_VIOLATION) || time.Now().Add(delay).After(deadline) {
+			return data, err
+		}
+		select {
+		case <-ctx.Done():
+			return nil, err
+		case <-time.After(delay):
+		}
+		delay = min(2*delay, 100*time.Millisecond)
+	}
+}
diff -ruN a/transport/internet/xdrive/params.go pt/transport/internet/xdrive/params.go
--- a/transport/internet/xdrive/params.go	1970-01-01 00:00:00.000000000 +0000
+++ b/transport/internet/xdrive/params.go	2026-11-24 19:03:30.389755575 +0000
@@ -0,0 +1,89 @@
+package xdrive
+
+import "time"
+
+const (
+	defaultSegmentBytes    = 512 * 1024
+	defaultFlushInterval   = 20 * time.Millisecond
+	defaultMinPollInterval = 50 * time.Millisecond
+	defaultMaxPollInterval = 500 * time.Millisecond
+	defaultEagerWindow     = 2 * time.Second
+	defaultHoleTimeout     = 30 * time.Second
+	defaultSessionTTL      = 5 * time.Minute
+	defaultConcurrency     = 8
+
+	maxSegmentBytes = 16 * 1024 * 1024
+	maxConcurrency  = 256
+)
+
+type params struct {
+	segmentBytes    int
+	flushInterval   time.Duration
+	minPollInterval time.Duration
+	maxPollInterval time.Duration
+	eagerWindow     time.Duration
+	holeTimeout     time.Duration
+	sessionTTL      time.Duration
+	concurrency     int
+}
+
+func millis(value uint32, fallback time.Duration) time.Duration {
+	if value == 0 {
+		return fallback
+	}
+	return time.Duration(value) * time.Millisecond
+}
+
+func seconds(value uint32, fallback time.Duration) time.Duration {
+	if value == 0 {
+		return fallback
+	}
+	return time.Duration(value) * time.Second
+}
+
+func capped(value uint32, fallback, limit int) int {
+	if value == 0 {
+		return fallback
+	}
+	if int(value) > limit {
+		return limit
+	}
+	return int(value)
+}
+
+func paramsFromConfig(c *Config) params {
+	p := params{
+		segmentBytes:    capped(c.SegmentBytes, defaultSegmentBytes, maxSegmentBytes),
+		flushInterval:   millis(c.FlushIntervalMs, defaultFlushInterval),
+		minPollInterval: millis(c.PollIntervalMs, defaultMinPollInterval),
+		maxPollInterval: millis(c.MaxPollIntervalMs, defaultMaxPollInterval),
+		eagerWindow:     millis(c.EagerWindowMs, defaultEagerWindow),
+		holeTimeout:     millis(c.HoleTimeoutMs, defaultHoleTimeout),
+		sessionTTL:      seconds(c.SessionTtlSeconds, defaultSessionTTL),
+		concurrency:     capped(c.Concurrency, defaultConcurrency, maxConcurrency),
+	}
+	if p.maxPollInterval < p.minPollInterval {
+		p.maxPollInterval = p.minPollInterval
+	}
+	return p
+}
+
+// paramsForStorage applies the Drive slot-path defaults only where the storage
+// is a slotStore and only to fields the config leaves at 0; wal-based backends
+// keep the defaults above because their concurrency and flush mean other things
+func paramsForStorage(c *Config, storage Storage) params {
+	if _, ok := storage.(slotStore); ok {
+		cc := *c
+		if cc.Concurrency == 0 {
+			cc.Concurrency = 64
+		}
+		if cc.FlushIntervalMs == 0 {
+			cc.FlushIntervalMs = 10
+		}
+		if cc.MaxPollIntervalMs == 0 {
+			cc.MaxPollIntervalMs = 200
+		}
+		c = &cc
+	}
+	return paramsFromConfig(c)
+}
diff -ruN a/transport/internet/xdrive/s3.go pt/transport/internet/xdrive/s3.go
--- a/transport/internet/xdrive/s3.go	1970-01-01 00:00:00.000000000 +0000
+++ b/transport/internet/xdrive/s3.go	2026-11-24 19:03:30.390755582 +0000
@@ -0,0 +1,518 @@
+package xdrive
+
+import (
+	"bytes"
+	"context"
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/xml"
+	stderrors "errors"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/exclavenetwork/exclave-core/v5/common/errors"
+	"github.com/exclavenetwork/exclave-core/v5/transport/internet"
+	"golang.org/x/net/http/httpguts"
+)
+
+type s3Storage struct {
+	*s3Shared
+	client   *http.Client
+	inflight chan struct{}
+	release  func()
+}
+
+type s3Shared struct {
+	conns                *connPool
+	base                 url.URL
+	prefix               string
+	region               string
+	accessKey, secretKey string
+	token                string
+	backoff              time.Duration
+}
+
+func s3Region(region string) string {
+	if region == "" {
+		return "us-east-1"
+	}
+	return region
+}
+
+func ValidateS3Config(c *Config) error {
+	if c == nil || c.S3 == nil {
+		return errors.New(`service "s3" needs an "s3" object`)
+	}
+	u, err := url.Parse(c.S3.Endpoint)
+	if err != nil || (u.Scheme != "https" && u.Scheme != "http") || u.Hostname() == "" ||
+		u.User != nil || u.RawQuery != "" || u.ForceQuery || u.Fragment != "" || u.Opaque != "" {
+		return errors.New("S3 endpoint must be an http(s) URL without credentials, query or fragment")
+	}
+	if !httpguts.ValidHeaderFieldValue(c.S3.Region) || strings.ContainsAny(c.S3.Region, "/, \t") {
+		return errors.New("invalid S3 signing region")
+	}
+	bucket := c.S3.Bucket
+	if !validS3Name(bucket) || strings.Contains(bucket, "/") {
+		return errors.New("S3 needs a bucket name without path separators")
+	}
+	if !c.S3.PathStyle {
+		if net.ParseIP(u.Hostname()) != nil {
+			return errors.New("S3 virtual-hosted addressing requires a DNS endpoint")
+		}
+		// In this mode the bucket is part of the HTTP authority, not its path.
+		if strings.Trim(bucket, "abcdefghijklmnopqrstuvwxyz0123456789-.") != "" || strings.Contains(bucket, "..") ||
+			strings.HasPrefix(bucket, ".") || strings.HasSuffix(bucket, ".") {
+			return errors.New("S3 virtual-hosted addressing requires a DNS-compatible bucket name")
+		}
+	}
+	if !validS3Name(strings.TrimSuffix(c.RemoteFolder, "/")) {
+		return errors.New("S3 remoteFolder must be a nonempty relative prefix without empty, '.' or '..' components")
+	}
+	if len(c.Secrets) < 2 || len(c.Secrets) > 3 || c.Secrets[0] == "" || c.Secrets[1] == "" {
+		return errors.New("S3 needs AccessKeyID, SecretAccessKey and optionally SessionToken in secrets")
+	}
+	for _, secret := range c.Secrets {
+		if !httpguts.ValidHeaderFieldValue(secret) {
+			return errors.New("invalid S3 secret")
+		}
+	}
+	if strings.ContainsAny(c.Secrets[0], "/ ,\t") {
+		return errors.New("invalid S3 AccessKeyID")
+	}
+	return nil
+}
+
+func validS3Name(name string) bool {
+	for _, ch := range name {
+		if ch < 0x20 || ch == 0x7f || ch == '\\' {
+			return false
+		}
+	}
+	for _, part := range strings.Split(name, "/") {
+		if part == "" || part == "." || part == ".." {
+			return false
+		}
+	}
+	return true
+}
+
+func newS3Storage(streamSettings *internet.MemoryStreamConfig, c *Config) (*s3Storage, error) {
+	if err := ValidateS3Config(c); err != nil {
+		return nil, err
+	}
+	base, _ := url.Parse(c.S3.Endpoint)
+	// Encode the endpoint prefix for SigV4 without turning escaped slashes into separators.
+	segments := strings.Split(base.EscapedPath(), "/")
+	for i, segment := range segments {
+		decoded, _ := url.PathUnescape(segment)
+		segments[i] = strings.ReplaceAll(s3EscapePath(decoded), "/", "%2F")
+	}
+	base.RawPath = strings.Join(segments, "/")
+	if !strings.HasSuffix(base.RawPath, "/") {
+		base.Path += "/"
+		base.RawPath += "/"
+	}
+	if c.S3.PathStyle {
+		base.Path += c.S3.Bucket + "/"
+		base.RawPath += s3EscapePath(c.S3.Bucket) + "/"
+	} else {
+		host := c.S3.Bucket + "." + base.Hostname()
+		if base.Port() != "" {
+			host = net.JoinHostPort(host, base.Port())
+		}
+		base.Host = host
+	}
+	if streamSettings == nil {
+		streamSettings = &internet.MemoryStreamConfig{}
+	}
+	h1Hosts := new(sync.Map)
+	newClient := func(ctx context.Context) *http.Client {
+		client := newServiceClient(ctx, h1Hosts, streamSettings, driveTimeout, driveMaxInflight)
+		// A redirect changes the signed host/path. Do not follow it with the old
+		// signature or send the session token to a different endpoint.
+		client.CheckRedirect = s3NoRedirect
+		return client
+	}
+	s := &s3Storage{
+		s3Shared: &s3Shared{
+			conns:     newConnPool(c.Xmux, newClient),
+			base:      *base,
+			prefix:    strings.TrimSuffix(c.RemoteFolder, "/") + "/",
+			region:    s3Region(c.S3.Region),
+			accessKey: c.Secrets[0],
+			secretKey: c.Secrets[1],
+			backoff:   200 * time.Millisecond,
+		},
+		client:   newClient(context.Background()),
+		inflight: make(chan struct{}, driveMaxInflight),
+	}
+	if len(c.Secrets) == 3 {
+		s.token = c.Secrets[2]
+	}
+	return s, nil
+}
+
+func s3NoRedirect(_ *http.Request, _ []*http.Request) error { return http.ErrUseLastResponse }
+
+func (s *s3Storage) session() Storage {
+	transport := &sessionTransport{pool: s.conns}
+	return &s3Storage{
+		s3Shared: s.s3Shared,
+		client:   &http.Client{Transport: transport, CheckRedirect: s3NoRedirect},
+		inflight: make(chan struct{}, cap(s.inflight)),
+		release:  transport.Close,
+	}
+}
+
+func (s *s3Storage) Close() error {
+	if s.release != nil {
+		s.release()
+	}
+	return nil
+}
+
+// SigV4 requires %20 for spaces, uppercase escapes, and unescaped key separators.
+func s3EscapePath(value string) string {
+	const digits = "0123456789ABCDEF"
+	var out strings.Builder
+	for i := 0; i < len(value); i++ {
+		ch := value[i]
+		if ch >= 'a' && ch <= 'z' || ch >= 'A' && ch <= 'Z' || ch >= '0' && ch <= '9' ||
+			ch == '-' || ch == '_' || ch == '.' || ch == '~' || ch == '/' {
+			out.WriteByte(ch)
+		} else {
+			out.WriteByte('%')
+			out.WriteByte(digits[ch>>4])
+			out.WriteByte(digits[ch&15])
+		}
+	}
+	return out.String()
+}
+
+func s3Hash(body []byte) string {
+	sum := sha256.Sum256(body)
+	return hex.EncodeToString(sum[:])
+}
+
+func s3HMAC(key []byte, value string) []byte {
+	h := hmac.New(sha256.New, key)
+	h.Write([]byte(value))
+	return h.Sum(nil)
+}
+
+func (s *s3Storage) sign(req *http.Request, payloadHash string, now time.Time) {
+	stamp, date := now.UTC().Format("20060102T150405Z"), now.UTC().Format("20060102")
+	req.Header.Set("X-Amz-Date", stamp)
+	req.Header.Set("X-Amz-Content-Sha256", payloadHash)
+	headers := "host:" + req.URL.Host + "\nx-amz-content-sha256:" + payloadHash + "\nx-amz-date:" + stamp + "\n"
+	signed := "host;x-amz-content-sha256;x-amz-date"
+	if contentType := req.Header.Get("Content-Type"); contentType != "" {
+		headers = "content-type:" + contentType + "\n" + headers
+		signed = "content-type;" + signed
+	}
+	if s.token != "" {
+		req.Header.Set("X-Amz-Security-Token", s.token)
+		headers += "x-amz-security-token:" + strings.Join(strings.Fields(s.token), " ") + "\n"
+		signed += ";x-amz-security-token"
+	}
+	// Sign the escaped path exactly as sent.
+	canonical := req.Method + "\n" + req.URL.EscapedPath() + "\n" + req.URL.RawQuery + "\n" +
+		headers + "\n" + signed + "\n" + payloadHash
+	scope := date + "/" + s.region + "/s3/aws4_request"
+	toSign := "AWS4-HMAC-SHA256\n" + stamp + "\n" + scope + "\n" + s3Hash([]byte(canonical))
+	key := s3HMAC([]byte("AWS4"+s.secretKey), date)
+	key = s3HMAC(key, s.region)
+	key = s3HMAC(key, "s3")
+	key = s3HMAC(key, "aws4_request")
+	req.Header.Set("Authorization", "AWS4-HMAC-SHA256 Credential="+s.accessKey+"/"+scope+
+		", SignedHeaders="+signed+", Signature="+hex.EncodeToString(s3HMAC(key, toSign)))
+}
+
+func (s *s3Storage) target(key string, query url.Values) string {
+	u := s.base
+	u.Path += key
+	u.RawPath += s3EscapePath(key)
+	// Parameters have fixed ASCII names and one value each; SigV4 uses %20 for spaces.
+	u.RawQuery = strings.ReplaceAll(query.Encode(), "+", "%20")
+	return u.String()
+}
+
+func (s *s3Storage) objectKey(name string) (string, error) {
+	if !validS3Name(name) {
+		return "", errors.New("invalid relative S3 object name")
+	}
+	key := s.prefix + name
+	if len(key) > 1024 {
+		return "", errors.New("S3 object key exceeds 1024 bytes")
+	}
+	return key, nil
+}
+
+// Retries use fresh signatures and hold a concurrency slot until the response body is read.
+func (s *s3Storage) do(ctx context.Context, method, key string, query url.Values, body []byte) (int, []byte, error) {
+	payloadHash := s3Hash(body)
+	backoff := s.backoff
+	var lastErr error
+	var retryAfter time.Duration
+	for attempt := 0; attempt < driveMaxAttempts; attempt++ {
+		if attempt > 0 {
+			delay := max(jitter(backoff), retryAfter)
+			timer := time.NewTimer(min(delay, driveMaxBackoff))
+			select {
+			case <-ctx.Done():
+				timer.Stop()
+				return 0, nil, ctx.Err()
+			case <-timer.C:
+			}
+			backoff = min(backoff*2, driveMaxBackoff)
+		}
+		select {
+		case s.inflight <- struct{}{}:
+		case <-ctx.Done():
+			return 0, nil, ctx.Err()
+		}
+		status, payload, after, err := s.attempt(ctx, method, key, query, body, payloadHash)
+		<-s.inflight
+		if ctx.Err() != nil {
+			return 0, nil, ctx.Err()
+		}
+		if err != nil && (!retryS3Error(err) || status >= 300 && !retryableStatus(status)) {
+			return 0, nil, err
+		}
+		if err == nil && !retryableStatus(status) {
+			return status, payload, nil
+		}
+		lastErr, retryAfter = err, after
+		if lastErr == nil {
+			lastErr = s3ResponseError(method, status, payload)
+		}
+	}
+	return 0, nil, lastErr
+}
+
+func retryS3Error(err error) bool {
+	var dns *net.DNSError
+	if stderrors.As(err, &dns) {
+		return dns.IsTimeout || dns.IsTemporary
+	}
+	var op *net.OpError
+	var network net.Error
+	return stderrors.Is(err, io.EOF) || stderrors.Is(err, io.ErrUnexpectedEOF) || stderrors.Is(err, errStalled) ||
+		stderrors.As(err, &op) || stderrors.As(err, &network) && network.Timeout()
+}
+
+func (s *s3Storage) attempt(ctx context.Context, method, key string, query url.Values, body []byte, hash string) (int, []byte, time.Duration, error) {
+	req, err := http.NewRequestWithContext(ctx, method, s.target(key, query), bytes.NewReader(body))
+	if err != nil {
+		return 0, nil, 0, errors.New("failed to build S3 request")
+	}
+	if method == http.MethodPut {
+		req.Header.Set("Content-Type", "application/octet-stream")
+	}
+	s.sign(req, hash, time.Now())
+	resp, err := s.client.Do(req)
+	if err != nil {
+		if urlErr, ok := err.(*url.Error); ok {
+			err = urlErr.Err
+		}
+		return 0, nil, 0, errors.New("S3 request failed").Base(err)
+	}
+	defer resp.Body.Close()
+	limit := int64(maxSegmentBytes)
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		limit = 64 << 10
+	}
+	payload, err := io.ReadAll(io.LimitReader(resp.Body, limit+1))
+	if err != nil {
+		return resp.StatusCode, nil, 0, errors.New("failed to read S3 response (HTTP ", resp.StatusCode, ")").Base(err)
+	}
+	if int64(len(payload)) > limit {
+		return 0, nil, 0, errors.New("S3 response exceeds size limit")
+	}
+	var after time.Duration
+	if raw := resp.Header.Get("Retry-After"); raw != "" {
+		if seconds, err := strconv.ParseInt(raw, 10, 32); err == nil && seconds > 0 {
+			after = min(time.Duration(seconds)*time.Second, driveMaxBackoff)
+		} else if at, err := http.ParseTime(raw); err == nil {
+			after = min(max(time.Until(at), 0), driveMaxBackoff)
+		}
+	}
+	return resp.StatusCode, payload, after, nil
+}
+
+func s3Missing(status int, payload []byte) bool {
+	if status != http.StatusNotFound {
+		return false
+	}
+	code := s3ErrorCode(payload)
+	return code == "NoSuchKey" || code == "NotFound"
+}
+
+func s3ErrorCode(payload []byte) string {
+	var response struct {
+		XMLName xml.Name `xml:"Error"`
+		Code    string
+	}
+	if xml.Unmarshal(payload, &response) != nil {
+		return ""
+	}
+	return response.Code
+}
+
+func s3ResponseError(method string, status int, payload []byte) error {
+	if code := s3ErrorCode(payload); code != "" {
+		return errors.New("S3 ", method, " answered ", status, " (", strconv.Quote(code), ")")
+	}
+	return errors.New("S3 ", method, " answered ", status)
+}
+
+func (s *s3Storage) Put(ctx context.Context, name string, data []byte) error {
+	key, err := s.objectKey(name)
+	if err != nil {
+		return err
+	}
+	status, payload, err := s.do(ctx, http.MethodPut, key, nil, data)
+	if err != nil {
+		return err
+	}
+	if status != http.StatusOK {
+		return s3ResponseError("PUT", status, payload)
+	}
+	return nil
+}
+
+func (s *s3Storage) Get(ctx context.Context, name string) ([]byte, error) {
+	key, err := s.objectKey(name)
+	if err != nil {
+		return nil, err
+	}
+	status, payload, err := s.do(ctx, http.MethodGet, key, nil, nil)
+	if err != nil {
+		return nil, err
+	}
+	if s3Missing(status, payload) {
+		return nil, errNotFound
+	}
+	if status != http.StatusOK {
+		return nil, s3ResponseError("GET", status, payload)
+	}
+	return payload, nil
+}
+
+type s3ListPage struct {
+	XMLName               xml.Name `xml:"ListBucketResult"`
+	IsTruncated           bool
+	NextContinuationToken string
+	Contents              []struct{ Key string }
+	CommonPrefixes        []struct{ Prefix string }
+}
+
+func (s *s3Storage) list(ctx context.Context, prefix, delimiter string, visit func(*s3ListPage) error) error {
+	query := url.Values{"list-type": {"2"}, "prefix": {prefix}, "max-keys": {"1000"}}
+	if delimiter != "" {
+		query.Set("delimiter", delimiter)
+	}
+	seen := make(map[string]bool)
+	for {
+		status, payload, err := s.do(ctx, http.MethodGet, "", query, nil)
+		if err != nil {
+			return err
+		}
+		if status != http.StatusOK {
+			return s3ResponseError("LIST", status, payload)
+		}
+		var page s3ListPage
+		if err := xml.Unmarshal(payload, &page); err != nil {
+			return errors.New("invalid S3 list response")
+		}
+		// Validate all keys before deleting any objects.
+		for _, item := range page.Contents {
+			if !strings.HasPrefix(item.Key, prefix) {
+				return errors.New("S3 returned an object outside the requested prefix")
+			}
+		}
+		for _, item := range page.CommonPrefixes {
+			if !strings.HasPrefix(item.Prefix, prefix) {
+				return errors.New("S3 returned a directory outside the requested prefix")
+			}
+		}
+		if page.IsTruncated {
+			if page.NextContinuationToken == "" || seen[page.NextContinuationToken] {
+				return errors.New("S3 list pagination did not advance")
+			}
+			seen[page.NextContinuationToken] = true
+		}
+		if err := visit(&page); err != nil {
+			return err
+		}
+		if !page.IsTruncated {
+			return nil
+		}
+		query.Set("continuation-token", page.NextContinuationToken)
+	}
+}
+
+func (s *s3Storage) List(ctx context.Context, prefix string) ([]Entry, error) {
+	key, err := s.objectKey(prefix)
+	if err != nil {
+		return nil, err
+	}
+	key += "/"
+	seen := make(map[string]bool)
+	var entries []Entry
+	add := func(full string) {
+		rest := strings.TrimPrefix(full, key)
+		name, _, _ := strings.Cut(rest, "/")
+		if name != "" && validS3Name(name) && !seen[name] {
+			seen[name] = true
+			entries = append(entries, Entry{Name: name})
+		}
+	}
+	err = s.list(ctx, key, "/", func(page *s3ListPage) error {
+		for _, item := range page.Contents {
+			add(item.Key)
+		}
+		for _, item := range page.CommonPrefixes {
+			add(item.Prefix)
+		}
+		return nil
+	})
+	return entries, err
+}
+
+func (s *s3Storage) deleteObject(ctx context.Context, key string) error {
+	status, payload, err := s.do(ctx, http.MethodDelete, key, nil, nil)
+	if err != nil {
+		return err
+	}
+	if status != http.StatusNoContent && status != http.StatusOK && !s3Missing(status, payload) {
+		return s3ResponseError("DELETE", status, payload)
+	}
+	return nil
+}
+
+// The trailing "/" prevents deleting streams/abcd when removing streams/abc.
+func (s *s3Storage) Delete(ctx context.Context, name string) error {
+	key, err := s.objectKey(name)
+	if err != nil {
+		return err
+	}
+	if err := s.deleteObject(ctx, key); err != nil {
+		return err
+	}
+	return s.list(ctx, key+"/", "", func(page *s3ListPage) error {
+		for _, item := range page.Contents {
+			if err := s.deleteObject(ctx, item.Key); err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+}
diff -ruN a/transport/internet/xdrive/slots.go pt/transport/internet/xdrive/slots.go
--- a/transport/internet/xdrive/slots.go	1970-01-01 00:00:00.000000000 +0000
+++ b/transport/internet/xdrive/slots.go	2026-11-24 19:03:48.684880708 +0000
@@ -0,0 +1,1071 @@
+package xdrive
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/json"
+	"hash/crc32"
+	"io"
+	"strconv"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/exclavenetwork/exclave-core/v5/common/errors"
+)
+
+// A session on a slotStore is carried in a ring of slots for each direction,
+// objects that both peers know by id: segment n is written to slot n % depth
+// and read from it, with nothing to list and no index to wait for. The reader
+// of a direction keeps how far it has read in a watermark, and the writer
+// reuses a slot only once that says what was in it before was taken
+
+const (
+	slotMagic     = "XDRVSL01"
+	slotHeaderLen = len(slotMagic) + 8 + 1 + 4 + 4
+	// slotInlineLimit is how large a segment is at most to go in the description
+	// of its slot, which takes one request less than a body
+	slotInlineLimit = 14 << 10
+	// inlineRampSegments segments of one size in a row double it, from
+	// slotInlineLimit up to segmentBytes
+	inlineRampSegments = 8
+
+	slotInline = 1
+	slotMedia  = 2
+	slotEnd    = 3
+	slotErr    = 4
+
+	// maxSlotIDLen bounds any slot or watermark id accepted from a peer.
+	maxSlotIDLen = 128
+)
+
+var (
+	// the head is asked for between slotHuntFloor and slotHuntCeiling, a segment
+	// behind it at about the pace that segments come
+	slotHuntFloor   = 10 * time.Millisecond
+	slotHuntCeiling = 25 * time.Millisecond
+	slotTailMin     = 150 * time.Millisecond
+	slotTailMax     = 800 * time.Millisecond
+	slotFetchAhead  = 12
+
+	slotAckRetry     = 30 * time.Millisecond
+	slotWatermarkTTL = 100 * time.Millisecond
+	slotStallTimeout = 60 * time.Second
+	slotCloseGrace   = 10 * time.Second
+	slotGoneTimeout  = 60 * time.Second
+	slotBodyHedge    = 2 * time.Second
+
+	slotReadAhead      int64 = 3
+	slotReadAheadPoll        = 40 * time.Millisecond
+	slotReadAheadBurst       = 500 * time.Millisecond
+)
+
+var slotWriteInflight = 12
+
+// slotStore is a storage of objects that are written and read again by id,
+// each with a description and a body
+type slotStore interface {
+	makeSlot(ctx context.Context, name string) (string, error)
+	// setSlot sets the description of a slot and, unless body is nil, its body
+	setSlot(ctx context.Context, id, description string, body []byte) error
+	readDescription(ctx context.Context, id string) (string, error)
+	readBody(ctx context.Context, id string) ([]byte, error)
+}
+
+// throttleStore is the optional part of a slotStore that reports how often
+// Drive throttled or timed out its requests; only driveStorage implements it
+type throttleStore interface {
+	throttled() int64
+}
+
+// slotFrame is what the description of a slot says: which segment it holds,
+// and either the segment itself or the size and checksum of the body that does
+type slotFrame struct {
+	seq  int64
+	mode byte
+	size int
+	crc  uint32
+	data []byte
+}
+
+func newSlotFrame(seq int64, mode byte, data []byte) slotFrame {
+	f := slotFrame{seq: seq, mode: mode, size: len(data), crc: crc32.ChecksumIEEE(data)}
+	if mode == slotInline {
+		f.data = data
+	}
+	return f
+}
+
+func (f slotFrame) encode() string {
+	b := make([]byte, slotHeaderLen, slotHeaderLen+len(f.data))
+	copy(b, slotMagic)
+	binary.BigEndian.PutUint64(b[8:], uint64(f.seq))
+	b[16] = f.mode
+	binary.BigEndian.PutUint32(b[17:], uint32(f.size))
+	binary.BigEndian.PutUint32(b[21:], f.crc)
+	return base64.StdEncoding.EncodeToString(append(b, f.data...))
+}
+
+func decodeSlot(description string) (slotFrame, bool) {
+	b, err := base64.StdEncoding.DecodeString(description)
+	if err != nil || len(b) < slotHeaderLen || string(b[:len(slotMagic)]) != slotMagic {
+		return slotFrame{}, false
+	}
+	f := slotFrame{
+		seq:  int64(binary.BigEndian.Uint64(b[8:])),
+		mode: b[16],
+		size: int(binary.BigEndian.Uint32(b[17:])),
+		crc:  binary.BigEndian.Uint32(b[21:]),
+	}
+	if f.mode == slotInline {
+		f.data = b[slotHeaderLen:]
+		if !f.holds(f.data) {
+			return slotFrame{}, false
+		}
+	}
+	return f, true
+}
+
+// holds reports whether body is the one that f is about, which a body read
+// right after its description need not be yet
+func (f slotFrame) holds(body []byte) bool {
+	return len(body) == f.size && crc32.ChecksumIEEE(body) == f.crc
+}
+
+// slotTable is the ring of one direction: the ids of its slots and of the
+// watermark of its reader
+type slotTable struct {
+	Slots     []string `json:"s"`
+	Watermark string   `json:"w"`
+}
+
+// ring is what a client announces a session with, the tables are named from
+// its side
+type ring struct {
+	Up    slotTable `json:"u"`
+	Down  slotTable `json:"d"`
+	First []byte    `json:"first,omitempty"`
+}
+
+func decodeRing(b []byte) (ring, bool) {
+	var r ring
+	if json.Unmarshal(b, &r) != nil || len(r.Up.Slots) == 0 || len(r.Down.Slots) == 0 ||
+		r.Up.Watermark == "" || r.Down.Watermark == "" {
+		return ring{}, false
+	}
+	if len(r.Up.Slots) > maxConcurrency || len(r.Down.Slots) > maxConcurrency {
+		return ring{}, false
+	}
+	for _, t := range []slotTable{r.Up, r.Down} {
+		if len(t.Watermark) > maxSlotIDLen {
+			return ring{}, false
+		}
+		for _, id := range t.Slots {
+			if len(id) == 0 || len(id) > maxSlotIDLen {
+				return ring{}, false
+			}
+		}
+	}
+	return r, true
+}
+
+// makeRing makes the slots and watermarks of a session, all at once
+func makeRing(ctx context.Context, store slotStore, session string, p params) (ring, error) {
+	depth := max(p.concurrency, 2)
+	r := ring{
+		Up:   slotTable{Slots: make([]string, depth)},
+		Down: slotTable{Slots: make([]string, depth)},
+	}
+	var (
+		wg      sync.WaitGroup
+		errOnce sync.Once
+		err     error
+	)
+	create := func(id *string, name string) {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			var e error
+			if *id, e = store.makeSlot(ctx, name); e != nil {
+				errOnce.Do(func() { err = e })
+			}
+		}()
+	}
+	for _, t := range []struct {
+		table  *slotTable
+		prefix string
+	}{{&r.Up, uplinkPrefix(session)}, {&r.Down, downlinkPrefix(session)}} {
+		for i := range t.table.Slots {
+			create(&t.table.Slots[i], t.prefix+"/s"+strconv.Itoa(i))
+		}
+		create(&t.table.Watermark, t.prefix+"/w")
+	}
+	wg.Wait()
+	return r, err
+}
+
+func readWatermark(ctx context.Context, store slotStore, id string) (int64, error) {
+	d, err := store.readDescription(context.WithValue(ctx, laneKey{}, true), id)
+	if err != nil || d == "" {
+		return -1, err
+	}
+	return strconv.ParseInt(d, 10, 64)
+}
+
+type slotWriter struct {
+	ctx   context.Context
+	store slotStore
+	table slotTable
+	params
+	// slots has a token for each segment on its way, at most one for each slot
+	slots chan struct{}
+	wg    sync.WaitGroup
+
+	mu       sync.Mutex
+	buf      []byte
+	seq      int64
+	size     int
+	full     int
+	lastSize int
+	held     int
+	closed   bool
+	err      error
+	first    chan []byte
+
+	// ackMu is held while the watermark is read, which other uploads wait for
+	ackMu    sync.Mutex
+	acked    int64
+	ackedAt  time.Time
+	progress time.Time
+}
+
+func newSlotWriter(ctx context.Context, store slotStore, table slotTable, p params) *slotWriter {
+	w := &slotWriter{
+		ctx:      ctx,
+		store:    store,
+		table:    table,
+		params:   p,
+		slots:    make(chan struct{}, min(len(table.Slots), slotWriteInflight)),
+		size:     min(slotInlineLimit, p.segmentBytes),
+		acked:    -1,
+		progress: time.Now(),
+	}
+	go w.flushLoop()
+	return w
+}
+
+func (w *slotWriter) Write(p []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+
+	if w.err != nil {
+		return 0, w.err
+	}
+	if w.closed {
+		return 0, io.ErrClosedPipe
+	}
+
+	w.buf = append(w.buf, p...)
+	for len(w.buf) >= w.size {
+		if err := w.flushLocked(); err != nil {
+			return 0, err
+		}
+	}
+	return len(p), nil
+}
+
+func (w *slotWriter) flushLoop() {
+	ticker := time.NewTicker(w.flushInterval)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-w.ctx.Done():
+			return
+		case <-ticker.C:
+			w.mu.Lock()
+			if !w.closed && w.err == nil && len(w.buf) > 0 && w.readyToFlush() {
+				w.flushLocked()
+			}
+			done := w.closed || w.err != nil
+			w.mu.Unlock()
+			if done {
+				return
+			}
+		}
+	}
+}
+
+func (w *slotWriter) readyToFlush() bool {
+	grew := len(w.buf) > w.lastSize
+	w.lastSize = len(w.buf)
+
+	if len(w.slots) > 0 && w.held < maxCoalescedTicks && len(w.buf) < w.size/2 {
+		w.held++
+		return false
+	}
+	if grew && w.held < maxCoalescedTicks {
+		w.held++
+		return false
+	}
+	w.held = 0
+	return true
+}
+
+// flushLocked sends a segment off buf once a slot is free, which it waits for
+// without w.mu, so that a reader that falls behind holds Write back. w.mu is
+// held
+func (w *slotWriter) flushLocked() error {
+	w.mu.Unlock()
+	select {
+	case w.slots <- struct{}{}:
+	case <-w.ctx.Done():
+		w.mu.Lock()
+		return w.ctx.Err()
+	}
+	w.mu.Lock()
+	if w.err != nil || len(w.buf) == 0 {
+		<-w.slots
+		return w.err
+	}
+
+	if w.size < w.segmentBytes && len(w.buf) >= w.size && len(w.slots)*4 > cap(w.slots)*3 {
+		w.size = w.segmentBytes
+		w.full = 0
+	}
+
+	n := min(len(w.buf), w.size)
+	if len(w.buf) > 4*slotInlineLimit {
+		// a burst goes at the full size at once
+		n = min(len(w.buf), w.segmentBytes)
+	}
+	if n > slotInlineLimit && len(w.buf) <= 2*cap(w.slots)*slotInlineLimit {
+		n = slotInlineLimit
+	}
+	if n == w.size && w.size < w.segmentBytes {
+		if w.full++; w.full == inlineRampSegments {
+			w.full = 0
+			w.size = min(2*w.size, w.segmentBytes)
+		}
+	}
+
+	chunk := bytes.Clone(w.buf[:n])
+	w.buf = append(w.buf[:0], w.buf[n:]...)
+	seq := w.seq
+	w.seq++
+	if seq == 0 && w.first != nil {
+		select {
+		case w.first <- chunk:
+		default:
+		}
+	}
+	w.lastSize = len(w.buf)
+	w.held = 0
+
+	w.wg.Add(1)
+	go w.upload(seq, chunk)
+	return nil
+}
+
+func (w *slotWriter) slotID(seq int64) string {
+	return w.table.Slots[seq%int64(len(w.table.Slots))]
+}
+
+func (w *slotWriter) upload(seq int64, chunk []byte) {
+	defer w.wg.Done()
+	defer func() { <-w.slots }()
+
+	mode := byte(slotMedia)
+	if len(chunk) <= slotInlineLimit {
+		mode = slotInline
+	}
+	began := time.Now()
+	if err := w.await(seq); err != nil {
+		w.fail(errors.New("failed to store segment ", seq).Base(err))
+		return
+	}
+	awaited := time.Since(began)
+	putAt := time.Now()
+	if err := w.write(seq, mode, chunk); err != nil {
+		w.fail(errors.New("failed to store segment ", seq).Base(err))
+		// the slot is free, the reader learns there what happened
+		w.write(seq, slotErr, nil)
+		return
+	}
+	logDebug(w.ctx, "xdrive write ", slotTag(w.table.Watermark), " seq=", seq, " bytes=", len(chunk),
+		" mode=", mode, " await=", awaited, " put=", time.Since(putAt))
+}
+
+func (w *slotWriter) write(seq int64, mode byte, data []byte) error {
+	f := newSlotFrame(seq, mode, data)
+	var body []byte
+	if mode == slotMedia {
+		body = data
+	}
+	return w.store.setSlot(w.ctx, w.slotID(seq), f.encode(), body)
+}
+
+// drained reports whether the reader took what the slot of seq held a lap
+// before. The watermark is read again only after slotWatermarkTTL, as one
+// that is old costs a wait but never what is in a slot
+func (w *slotWriter) drained(seq int64) (bool, error) {
+	w.ackMu.Lock()
+	defer w.ackMu.Unlock()
+
+	before := seq - int64(len(w.table.Slots))
+	if w.acked >= before {
+		return true, nil
+	}
+	if time.Since(w.ackedAt) < slotWatermarkTTL {
+		return false, nil
+	}
+	acked, err := readWatermark(w.ctx, w.store, w.table.Watermark)
+	if err != nil {
+		return false, err
+	}
+	w.ackedAt = time.Now()
+	if acked > w.acked {
+		w.acked, w.progress = acked, w.ackedAt
+	}
+	return w.acked >= before, nil
+}
+
+// await waits for drained, for slotStallTimeout at most, or slotCloseGrace
+// without progress once the writer is closed
+func (w *slotWriter) await(seq int64) error {
+	start := time.Now()
+	wait := slotAckRetry
+	for {
+		ok, err := w.drained(seq)
+		if ok {
+			return nil
+		}
+		w.mu.Lock()
+		closed := w.closed
+		w.mu.Unlock()
+		w.ackMu.Lock()
+		still := time.Since(w.progress)
+		w.ackMu.Unlock()
+		if min(time.Since(start), still) > slotStallTimeout || closed && still > slotCloseGrace {
+			return errors.New("the reader took nothing from slot ", w.slotID(seq), " for ", still).Base(err)
+		}
+
+		if err != nil {
+			wait = min(2*wait, 2*time.Second)
+		} else {
+			wait = slotAckRetry
+		}
+		select {
+		case <-w.ctx.Done():
+			return w.ctx.Err()
+		case <-time.After(wait):
+		}
+	}
+}
+
+func (w *slotWriter) fail(err error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if w.err == nil {
+		w.err = err
+	}
+}
+
+func (w *slotWriter) Close() error {
+	w.mu.Lock()
+	if w.closed {
+		w.mu.Unlock()
+		return nil
+	}
+	w.closed = true
+	for len(w.buf) > 0 && w.err == nil {
+		if err := w.flushLocked(); err != nil {
+			w.mu.Unlock()
+			return err
+		}
+	}
+	seq := w.seq
+	w.mu.Unlock()
+
+	w.ackMu.Lock()
+	w.progress = time.Now()
+	w.ackMu.Unlock()
+
+	w.wg.Wait()
+
+	w.mu.Lock()
+	err := w.err
+	w.mu.Unlock()
+	if err != nil {
+		return err
+	}
+	if err := w.await(seq); err != nil {
+		return err
+	}
+	return w.write(seq, slotEnd, nil)
+}
+
+type slotReader struct {
+	ctx   context.Context
+	store slotStore
+	table slotTable
+	params
+
+	ch   chan []byte
+	wake chan struct{}
+	acks chan struct{}
+	grow chan struct{}
+
+	mu      sync.Mutex
+	head    int64
+	started bool
+	// hitAt is when a segment last came and gap the time between them, activeAt
+	// when a segment came, was seen coming or Wake. Nothing for the eager window
+	// is idle, and active is closed when that ends
+	hitAt        time.Time
+	gap          time.Duration
+	activeAt     time.Time
+	active       chan struct{}
+	frontier     int64
+	err          error
+	stop         context.CancelFunc
+	reads        atomic.Int64
+	tailMin      time.Duration
+	tailMax      time.Duration
+	stallTimeout time.Duration
+	bodyRate     float64
+}
+
+func newSlotReader(ctx context.Context, store slotStore, table slotTable, p params, first []byte) *slotReader {
+	head := int64(0)
+	if len(first) > 0 {
+		head = 1
+	}
+	runCtx, stop := context.WithCancel(ctx)
+	r := &slotReader{
+		ctx:          runCtx,
+		stop:         stop,
+		store:        store,
+		table:        table,
+		params:       p,
+		head:         head,
+		started:      len(first) > 0,
+		ch:           make(chan []byte, max(p.concurrency, 1)),
+		wake:         make(chan struct{}, 1),
+		acks:         make(chan struct{}, 1),
+		grow:         make(chan struct{}, 1),
+		hitAt:        time.Now(),
+		activeAt:     time.Now(),
+		active:       make(chan struct{}),
+		tailMin:      slotTailMin,
+		tailMax:      slotTailMax,
+		stallTimeout: slotStallTimeout,
+	}
+	if len(first) > 0 {
+		r.ch <- first
+		select {
+		case r.acks <- struct{}{}:
+		default:
+		}
+	}
+	go r.run()
+	go r.ackLoop()
+	return r
+}
+
+func (r *slotReader) chunks() <-chan []byte {
+	return r.ch
+}
+
+// Wake has the head asked for now, as an answer is likely to come
+func (r *slotReader) Wake() {
+	r.mu.Lock()
+	r.touch()
+	r.mu.Unlock()
+	select {
+	case r.wake <- struct{}{}:
+	default:
+	}
+}
+
+func (r *slotReader) slotID(seq int64) string {
+	return r.table.Slots[seq%int64(len(r.table.Slots))]
+}
+
+type slotFetch struct {
+	ready chan struct{}
+	// promoted is closed when the segment becomes the head
+	promoted chan struct{}
+	near     chan struct{}
+	body     []byte
+	end      bool
+	err      error
+	born     time.Time
+	readyAt  time.Time
+}
+
+func (f *slotFetch) enter() {
+	select {
+	case <-f.near:
+	default:
+		close(f.near)
+	}
+}
+
+func (r *slotReader) run() {
+	defer close(r.ch)
+	ctx, cancel := context.WithCancel(r.ctx)
+	defer cancel()
+
+	fetches := make(map[int64]*slotFetch)
+	for {
+		r.mu.Lock()
+		head, started, frontier := r.head, r.started, r.frontier
+		r.mu.Unlock()
+
+		window := 1
+		if started {
+			window = min(max(int(frontier-head)+slotFetchAhead, slotFetchAhead), len(r.table.Slots))
+		}
+		for i := range window {
+			seq := head + int64(i)
+			if fetches[seq] == nil {
+				fetches[seq] = &slotFetch{ready: make(chan struct{}), promoted: make(chan struct{}), near: make(chan struct{}), born: time.Now()}
+				if int64(i) <= slotReadAhead {
+					fetches[seq].enter()
+				}
+				go r.fetch(ctx, seq, i, fetches[seq])
+			}
+		}
+
+		f := fetches[head]
+		select {
+		case <-f.ready:
+		case <-r.grow:
+			continue
+		case <-ctx.Done():
+			return
+		}
+		delete(fetches, head)
+		if f.err != nil {
+			r.setErr(f.err)
+			return
+		}
+		if f.end {
+			return
+		}
+
+		// the slot is free once the bytes are here, not once they are read
+		r.mu.Lock()
+		r.head++
+		r.started = true
+		r.mu.Unlock()
+		logDebug(r.ctx, "xdrive read ", slotTag(r.table.Watermark), " seq=", head, " fetch=",
+			f.readyAt.Sub(f.born), " blocked=", time.Since(f.readyAt), " bytes=", len(f.body),
+			" reads=", r.reads.Load())
+		if next := fetches[head+1]; next != nil {
+			close(next.promoted)
+			if nf := fetches[head+1+slotReadAhead]; nf != nil {
+				nf.enter()
+			}
+		}
+		select {
+		case r.acks <- struct{}{}:
+		default:
+		}
+
+		select {
+		case r.ch <- f.body:
+		case <-ctx.Done():
+			return
+		}
+	}
+}
+
+func (r *slotReader) isHead(seq int64) bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.head == seq
+}
+
+func (r *slotReader) bursting() bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return time.Since(r.hitAt) <= slotReadAheadBurst
+}
+
+func (r *slotReader) reach(seq int64) {
+	r.mu.Lock()
+	grown := seq > r.frontier
+	if grown {
+		r.frontier = seq
+	}
+	r.mu.Unlock()
+	if grown {
+		select {
+		case r.grow <- struct{}{}:
+		default:
+		}
+	}
+}
+
+// fetch asks for the slot of seq until it holds seq: the head often, a segment
+// behind it soon after it was asked for, then at the pace that segments come
+func (r *slotReader) fetch(ctx context.Context, seq int64, offset int, f *slotFetch) {
+	defer func() {
+		f.readyAt = time.Now()
+		close(f.ready)
+	}()
+	if offset > 0 && !r.hold(ctx, r.tailMin, f.promoted, f.near) {
+		return
+	}
+
+	id := r.slotID(seq)
+	backoff := slotHuntFloor
+	var goneSince, warnedAt, visibleSince time.Time
+	for {
+		var description string
+		var err error
+		r.mu.Lock()
+		hot := time.Since(r.activeAt) <= r.eagerWindow
+		r.mu.Unlock()
+		if hot && r.isHead(seq) {
+			description, err = r.readHead(ctx, id, seq)
+		} else {
+			r.reads.Add(1)
+			description, err = r.store.readDescription(ctx, id)
+		}
+		frame, ok := decodeSlot(description)
+		if err == errNotFound || (err == nil && description == "") {
+			// An absent or empty slot is idle, not a failure.
+			visibleSince = time.Time{}
+		}
+		switch {
+		case err == nil && ok && frame.seq == seq:
+			// what follows it is asked for while its body comes
+			r.mu.Lock()
+			r.touch()
+			r.mu.Unlock()
+			r.reach(seq)
+			switch frame.mode {
+			case slotEnd:
+				f.end = true
+				return
+			case slotErr:
+				f.err = errors.New("the peer could not store segment ", seq)
+				return
+			case slotInline:
+				f.body = frame.data
+				r.hit()
+				return
+			case slotMedia:
+				body, bodyErr := r.readBodyHedged(ctx, id, frame.size)
+				if bodyErr == nil && frame.holds(body) {
+					f.body = body
+					r.hit()
+					return
+				}
+				if ctx.Err() == nil && time.Since(warnedAt) > 10*time.Second {
+					warnedAt = time.Now()
+					if bodyErr != nil {
+						logWarningInner(ctx, bodyErr, "failed to read body of slot ", id)
+					} else {
+						logWarning(ctx, "body of slot ", id, " does not match segment ", seq)
+					}
+				}
+				if visibleSince.IsZero() {
+					visibleSince = time.Now()
+				}
+				if time.Since(visibleSince) > r.stallTimeout {
+					f.err = errors.New("segment ", seq, " has no usable body after ", r.stallTimeout).Base(bodyErr)
+					return
+				}
+			}
+		case err == nil && !ok && description != "":
+			// A present but undecodable description for this slot is not idle;
+			// fail once it has persisted beyond the stall timeout.
+			if visibleSince.IsZero() {
+				visibleSince = time.Now()
+			}
+			if time.Since(visibleSince) > r.stallTimeout {
+				f.err = errors.New("slot ", id, " of segment ", seq, " holds an invalid frame")
+				return
+			}
+		case err == errNotFound:
+			if goneSince.IsZero() {
+				goneSince = time.Now()
+			} else if time.Since(goneSince) > slotGoneTimeout && r.isHead(seq) {
+				f.err = errors.New("slot ", id, " of segment ", seq, " is gone").Base(err)
+				return
+			}
+		case err != nil:
+			if isAuthError(err) {
+				f.err = err
+				return
+			}
+			goneSince = time.Time{}
+			if ctx.Err() == nil && time.Since(warnedAt) > 10*time.Second {
+				warnedAt = time.Now()
+				logWarningInner(ctx, err, "failed to read slot ", id)
+			}
+		}
+
+		r.mu.Lock()
+		head, idle, active := r.head == seq, time.Since(r.activeAt) > r.eagerWindow, r.active
+		r.mu.Unlock()
+		wait, a, b := backoff, (<-chan struct{})(r.wake), (<-chan struct{})(nil)
+		switch {
+		case head:
+			ceiling := slotHuntCeiling
+			if idle {
+				ceiling = max(ceiling, r.maxPollInterval)
+			}
+			backoff = min(2*backoff, ceiling)
+		case idle:
+			// only the head is asked for until something comes
+			wait, a, b, backoff = 0, f.promoted, active, slotHuntFloor
+		default:
+			wait, a, b, backoff = min(max(r.pace(), r.tailMin), r.tailMax), f.promoted, f.near, slotHuntFloor
+			select {
+			case <-f.near:
+				b = nil
+				if r.bursting() {
+					wait = slotReadAheadPoll
+				}
+			default:
+			}
+		}
+		if !r.hold(ctx, wait, a, b) {
+			return
+		}
+	}
+}
+
+func (r *slotReader) readHead(ctx context.Context, id string, seq int64) (string, error) {
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	ctx = context.WithValue(ctx, laneKey{}, true)
+
+	type result struct {
+		description string
+		err         error
+	}
+	results := make(chan result, 4)
+	outstanding := 0
+	launch := func() {
+		outstanding++
+		go func() {
+			r.reads.Add(1)
+			description, err := r.store.readDescription(ctx, id)
+			results <- result{description, err}
+		}()
+	}
+	launch()
+	ticker := time.NewTicker(slotHuntCeiling)
+	defer ticker.Stop()
+	var last result
+	seen := false
+	for {
+		select {
+		case res := <-results:
+			outstanding--
+			if res.err != nil {
+				return res.description, res.err
+			}
+			if frame, ok := decodeSlot(res.description); ok && frame.seq == seq {
+				return res.description, nil
+			}
+			last, seen = res, true
+		case <-ticker.C:
+			r.mu.Lock()
+			idle := time.Since(r.activeAt) > r.eagerWindow
+			r.mu.Unlock()
+			switch {
+			case idle && seen:
+				return last.description, nil
+			case !idle && outstanding < 3:
+				launch()
+			}
+		case <-r.wake:
+			if outstanding < 3 {
+				launch()
+			}
+		case <-ctx.Done():
+			return "", ctx.Err()
+		}
+	}
+}
+
+func (r *slotReader) readBodyHedged(ctx context.Context, id string, size int) ([]byte, error) {
+	if slotBodyHedge <= 0 {
+		return r.store.readBody(ctx, id)
+	}
+	delay := slotBodyHedge
+	r.mu.Lock()
+	rate := r.bodyRate
+	r.mu.Unlock()
+	if rate > 0 && size > 0 {
+		if scaled := time.Duration(float64(2*size) / rate * float64(time.Second)); scaled > delay {
+			delay = scaled
+		}
+	}
+	ctx, cancel := context.WithCancel(ctx)
+	defer cancel()
+	start := time.Now()
+
+	type result struct {
+		body []byte
+		err  error
+	}
+	results := make(chan result, 2)
+	launch := func() {
+		go func() {
+			body, err := r.store.readBody(ctx, id)
+			results <- result{body, err}
+		}()
+	}
+	launch()
+	outstanding := 1
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+	var last result
+	for {
+		select {
+		case res := <-results:
+			outstanding--
+			if res.err == nil {
+				if elapsed := time.Since(start); elapsed > 0 && len(res.body) > 0 {
+					instant := float64(len(res.body)) / elapsed.Seconds()
+					r.mu.Lock()
+					if r.bodyRate == 0 {
+						r.bodyRate = instant
+					} else {
+						r.bodyRate = (r.bodyRate + instant) / 2
+					}
+					r.mu.Unlock()
+				}
+				return res.body, nil
+			}
+			last = res
+			if outstanding == 0 {
+				return nil, last.err
+			}
+		case <-timer.C:
+			if outstanding == 1 {
+				launch()
+				outstanding++
+			}
+		case <-ctx.Done():
+			return nil, ctx.Err()
+		}
+	}
+}
+
+// pace is about how long segments take to come one after the other
+func (r *slotReader) pace() time.Duration {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return min(max(r.gap, 300*time.Millisecond), 3*time.Second)
+}
+
+func (r *slotReader) hit() {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if gap := time.Since(r.hitAt); r.gap == 0 {
+		r.gap = gap
+	} else {
+		r.gap = (r.gap + gap) / 2
+	}
+	r.hitAt = time.Now()
+	r.touch()
+}
+
+// touch notes that something came or is likely to. r.mu is held
+func (r *slotReader) touch() {
+	if time.Since(r.activeAt) > r.eagerWindow {
+		close(r.active)
+		r.active = make(chan struct{})
+	}
+	r.activeAt = time.Now()
+}
+
+// hold waits d, unless d is 0, or until a or b is closed or has a value
+func (r *slotReader) hold(ctx context.Context, d time.Duration, a, b <-chan struct{}) bool {
+	var timeout <-chan time.Time
+	if d > 0 {
+		timer := time.NewTimer(d)
+		defer timer.Stop()
+		timeout = timer.C
+	}
+	select {
+	case <-ctx.Done():
+		return false
+	case <-a:
+	case <-b:
+	case <-timeout:
+	}
+	return true
+}
+
+// ackLoop writes the watermark when the head moves, the last head only if it
+// moved more than once meanwhile
+func (r *slotReader) ackLoop() {
+	acked := int64(-1)
+	wait := slotAckRetry
+	for {
+		select {
+		case <-r.ctx.Done():
+			return
+		case <-r.acks:
+		}
+		for {
+			r.mu.Lock()
+			want := r.head - 1
+			r.mu.Unlock()
+			if want <= acked {
+				break
+			}
+			if err := r.store.setSlot(context.WithValue(r.ctx, laneKey{}, true), r.table.Watermark, strconv.FormatInt(want, 10), nil); err == nil {
+				acked, wait = want, slotAckRetry
+				continue
+			}
+			wait = min(2*wait, 5*time.Second)
+			select {
+			case <-r.ctx.Done():
+				return
+			case <-time.After(wait):
+			}
+		}
+	}
+}
+
+func (r *slotReader) setErr(err error) {
+	r.mu.Lock()
+	if r.err == nil {
+		r.err = err
+	}
+	r.mu.Unlock()
+	// A stored error means the connection is dead: stop the run loop so the
+	// chunk channel closes and Read returns the error instead of blocking.
+	if r.stop != nil {
+		r.stop()
+	}
+}
+
+func (r *slotReader) Err() error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.err != nil {
+		return r.err
+	}
+	return io.EOF
+}
+
+func slotTag(id string) string {
+	if len(id) > 6 {
+		return id[len(id)-6:]
+	}
+	return id
+}
diff -ruN a/transport/internet/xdrive/storage.go pt/transport/internet/xdrive/storage.go
--- a/transport/internet/xdrive/storage.go	1970-01-01 00:00:00.000000000 +0000
+++ b/transport/internet/xdrive/storage.go	2026-11-24 19:07:17.308269296 +0000
@@ -0,0 +1,124 @@
+package xdrive
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"strings"
+	"sync"
+	"sync/atomic"
+
+	"github.com/exclavenetwork/exclave-core/v5/common/errors"
+	"github.com/exclavenetwork/exclave-core/v5/transport/internet"
+)
+
+var errNotFound = errors.New("object not found")
+
+type Entry struct {
+	Name   string
+	Inline []byte
+}
+
+type Storage interface {
+	Put(ctx context.Context, name string, data []byte) error
+	Get(ctx context.Context, name string) ([]byte, error)
+	Delete(ctx context.Context, name string) error
+	List(ctx context.Context, prefix string) ([]Entry, error)
+	Close() error
+}
+
+// testStorageFactory lets tests substitute a backend for newStorage; nil in
+// production so behaviour is unchanged.
+var testStorageFactory atomic.Pointer[func(config *Config) (Storage, error)]
+
+func newStorage(streamSettings *internet.MemoryStreamConfig) (Storage, error) {
+	config, err := streamConfig(streamSettings)
+	if err != nil {
+		return nil, err
+	}
+	if f := testStorageFactory.Load(); f != nil {
+		return (*f)(config)
+	}
+
+	switch config.Service {
+	case "local":
+		return newLocalStorage(config.RemoteFolder)
+	case "google-drive", "Google Drive":
+		return sharedStorage(streamSettings, config, func() (Storage, error) {
+			return newDriveStorage(streamSettings, config)
+		})
+	case "template":
+		return sharedStorage(streamSettings, config, func() (Storage, error) {
+			return newTemplateStorage(streamSettings, config)
+		})
+	case "s3":
+		return sharedStorage(streamSettings, config, func() (Storage, error) {
+			return newS3Storage(streamSettings, config)
+		})
+	default:
+		return nil, errors.New("unsupported service: ", config.Service)
+	}
+}
+
+// sessionStorage returns the storage of one session, which takes connections
+// of XMUX until Close, with the token and cache of storage. Local storage has
+// no connections
+func sessionStorage(storage Storage) Storage {
+	switch s := storage.(type) {
+	case *driveStorage:
+		return s.session()
+	case *templateStorage:
+		return s.session()
+	case *s3Storage:
+		return s.session()
+	}
+	return storage
+}
+
+var (
+	sharedMu sync.Mutex
+	shared   = make(map[string]Storage)
+)
+
+func shareKey(streamSettings *internet.MemoryStreamConfig, config *Config) string {
+	parts := []string{config.Service, config.RemoteFolder}
+	if config.S3 != nil {
+		parts = append(parts, config.S3.Endpoint, s3Region(config.S3.Region), config.S3.Bucket)
+		if config.S3.PathStyle {
+			parts = append(parts, "path-style")
+		} else {
+			parts = append(parts, "virtual-hosted-style")
+		}
+	}
+	parts = append(parts, config.Secrets...)
+	if streamSettings != nil {
+		parts = append(parts, streamSettings.SecurityType)
+		// NC_XDRIVE: the fork's MemoryStreamConfig has no Destination
+		// (fronting) field; the share key falls back to the dialed host.
+	}
+	sum := sha256.Sum256([]byte(strings.Join(parts, "\x00")))
+	return hex.EncodeToString(sum[:])
+}
+
+func resetSharedStorage() {
+	sharedMu.Lock()
+	shared = make(map[string]Storage)
+	sharedMu.Unlock()
+}
+
+func sharedStorage(streamSettings *internet.MemoryStreamConfig, config *Config, build func() (Storage, error)) (Storage, error) {
+	key := shareKey(streamSettings, config)
+
+	sharedMu.Lock()
+	defer sharedMu.Unlock()
+
+	if storage, ok := shared[key]; ok {
+		return storage, nil
+	}
+	storage, err := build()
+	if err != nil {
+		return nil, err
+	}
+	shared[key] = storage
+	return storage, nil
+}
diff -ruN a/transport/internet/xdrive/template.go pt/transport/internet/xdrive/template.go
--- a/transport/internet/xdrive/template.go	1970-01-01 00:00:00.000000000 +0000
+++ b/transport/internet/xdrive/template.go	2026-11-24 19:03:30.393755603 +0000
@@ -0,0 +1,509 @@
+package xdrive
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"io"
+	"net/http"
+	"regexp"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/exclavenetwork/exclave-core/v5/common/errors"
+	"github.com/exclavenetwork/exclave-core/v5/transport/internet"
+)
+
+type authTemplate struct {
+	Type       string            `json:"type"`
+	Header     map[string]string `json:"header"`
+	Username   string            `json:"username"`
+	Password   string            `json:"password"`
+	TokenURL   string            `json:"tokenUrl"`
+	Form       map[string]string `json:"form"`
+	TokenPath  string            `json:"tokenPath"`
+	ExpiryPath string            `json:"expiryPath"`
+}
+
+type opTemplate struct {
+	Method     string            `json:"method"`
+	URL        string            `json:"url"`
+	Headers    map[string]string `json:"headers"`
+	Body       string            `json:"body"`
+	NamesRegex string            `json:"namesRegex"`
+
+	// HrefPath makes the operation two-step, as in the Yandex Disk REST API: the first request
+	// answers with a JSON body, the URL found at HrefPath is then called with HrefMethod (GET by
+	// default), carrying the payload. The URL is used as given, with neither auth nor headers.
+	HrefPath   string `json:"hrefPath"`
+	HrefMethod string `json:"hrefMethod"`
+
+	presigned bool
+}
+
+type retryTemplate struct {
+	Status     []int  `json:"status"`
+	RateReason string `json:"rateReason"`
+}
+
+type storageTemplate struct {
+	Flatten     bool          `json:"flatten"`
+	Concurrency int           `json:"concurrency"`
+	Auth        authTemplate  `json:"auth"`
+	Put         opTemplate    `json:"put"`
+	Get         opTemplate    `json:"get"`
+	Delete      opTemplate    `json:"delete"`
+	List        opTemplate    `json:"list"`
+	Retry       retryTemplate `json:"retry"`
+
+	names *regexp.Regexp
+}
+
+type templateStorage struct {
+	*templateShared
+	// a session has a client and inflight of its own, see session
+	client   *http.Client
+	inflight chan struct{}
+	release  func()
+}
+
+// templateShared is what the sessions of a storage have in common
+type templateShared struct {
+	conns       *connPool
+	tmpl        *storageTemplate
+	tokenClient *http.Client
+	folder      string
+	secrets     []string
+
+	tokenMu     sync.Mutex
+	token       string
+	tokenExpiry time.Time
+}
+
+func newTemplateStorage(streamSettings *internet.MemoryStreamConfig, config *Config) (*templateStorage, error) {
+	tmpl := &storageTemplate{}
+	if err := json.Unmarshal([]byte(config.Template), tmpl); err != nil {
+		return nil, errors.New("invalid template").Base(err)
+	}
+	if tmpl.Put.URL == "" || tmpl.Get.URL == "" || tmpl.List.URL == "" || tmpl.Delete.URL == "" {
+		return nil, errors.New("template needs put, get, list and delete operations")
+	}
+	if tmpl.List.NamesRegex == "" {
+		return nil, errors.New("template list needs a namesRegex")
+	}
+	re, err := regexp.Compile(tmpl.List.NamesRegex)
+	if err != nil {
+		return nil, errors.New("bad namesRegex").Base(err)
+	}
+	if re.NumSubexp() < 1 {
+		return nil, errors.New("namesRegex needs one capture group")
+	}
+	tmpl.names = re
+
+	conc := tmpl.Concurrency
+	if conc <= 0 {
+		conc = driveMaxInflight
+	}
+	if conc > maxTemplateConcurrency {
+		conc = maxTemplateConcurrency
+	}
+
+	h1Hosts := new(sync.Map)
+	client := newServiceClient(context.Background(), h1Hosts, streamSettings, driveTimeout, conc)
+	return &templateStorage{
+		templateShared: &templateShared{
+			conns: newConnPool(config.Xmux, func(connCtx context.Context) *http.Client {
+				return newServiceClient(connCtx, h1Hosts, streamSettings, driveTimeout, conc)
+			}),
+			tmpl:        tmpl,
+			tokenClient: client,
+			folder:      config.RemoteFolder,
+			secrets:     config.Secrets,
+		},
+		client:   client,
+		inflight: make(chan struct{}, conc),
+	}, nil
+}
+
+// session returns a storage for one session, over the connections of XMUX
+// until Close, with the token of s
+func (s *templateStorage) session() Storage {
+	transport := &sessionTransport{pool: s.conns}
+	return &templateStorage{
+		templateShared: s.templateShared,
+		client:         &http.Client{Transport: transport},
+		inflight:       make(chan struct{}, cap(s.inflight)),
+		release:        transport.Close,
+	}
+}
+
+const maxTemplateConcurrency = 256
+
+func (s *templateStorage) baseVars() map[string]string {
+	vars := map[string]string{"folder": s.folder}
+	for i, secret := range s.secrets {
+		vars["secret"+itoa(i)] = secret
+	}
+	return vars
+}
+
+func subst(tmpl string, vars map[string]string) string {
+	if tmpl == "" || !strings.ContainsRune(tmpl, '{') {
+		return tmpl
+	}
+	out := tmpl
+	for k, v := range vars {
+		out = strings.ReplaceAll(out, "{"+k+"}", v)
+	}
+	return out
+}
+
+func itoa(i int) string {
+	if i == 0 {
+		return "0"
+	}
+	var b [20]byte
+	pos := len(b)
+	for i > 0 {
+		pos--
+		b[pos] = byte('0' + i%10)
+		i /= 10
+	}
+	return string(b[pos:])
+}
+
+func (s *templateStorage) storedName(name string) string {
+	if s.tmpl.Flatten {
+		return flatten(name)
+	}
+	return name
+}
+
+func (s *templateStorage) retryable(status int, payload []byte) bool {
+	for _, code := range s.tmpl.Retry.Status {
+		if status == code {
+			return true
+		}
+	}
+	if status == http.StatusForbidden && s.tmpl.Retry.RateReason != "" {
+		if reason := jsonString(payload, s.tmpl.Retry.RateReason); reason != "" {
+			return true
+		}
+	}
+	return false
+}
+
+func (s *templateStorage) authHeaders(ctx context.Context, vars map[string]string) (map[string]string, error) {
+	switch s.tmpl.Auth.Type {
+	case "", "none":
+		return nil, nil
+	case "static", "oauth2":
+		if s.tmpl.Auth.Type == "oauth2" {
+			token, err := s.accessToken(ctx)
+			if err != nil {
+				return nil, err
+			}
+			vars["token"] = token
+		}
+		headers := make(map[string]string, len(s.tmpl.Auth.Header))
+		for k, v := range s.tmpl.Auth.Header {
+			headers[k] = subst(v, vars)
+		}
+		return headers, nil
+	case "basic":
+		user := subst(s.tmpl.Auth.Username, vars)
+		pass := subst(s.tmpl.Auth.Password, vars)
+		enc := base64.StdEncoding.EncodeToString([]byte(user + ":" + pass))
+		return map[string]string{"Authorization": "Basic " + enc}, nil
+	default:
+		return nil, errors.New("unsupported auth type: ", s.tmpl.Auth.Type)
+	}
+}
+
+func (s *templateStorage) accessToken(ctx context.Context) (string, error) {
+	s.tokenMu.Lock()
+	defer s.tokenMu.Unlock()
+
+	if s.token != "" && time.Now().Before(s.tokenExpiry) {
+		return s.token, nil
+	}
+
+	form := make(map[string]string, len(s.tmpl.Auth.Form))
+	vars := s.baseVars()
+	values := strings.Builder{}
+	first := true
+	for k, v := range s.tmpl.Auth.Form {
+		form[k] = subst(v, vars)
+		if !first {
+			values.WriteByte('&')
+		}
+		first = false
+		values.WriteString(k)
+		values.WriteByte('=')
+		values.WriteString(form[k])
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, s.tmpl.Auth.TokenURL,
+		strings.NewReader(values.String()))
+	if err != nil {
+		return "", errors.New("failed to build the token request").Base(err)
+	}
+	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
+
+	resp, err := s.tokenClient.Do(req)
+	if err != nil {
+		return "", errors.New("failed to fetch the token").Base(err)
+	}
+	defer resp.Body.Close()
+	payload, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	if err != nil {
+		return "", errors.New("failed to read the token response").Base(err)
+	}
+	if resp.StatusCode != http.StatusOK {
+		return "", errors.New("the token endpoint answered ", resp.StatusCode, ": ", string(payload))
+	}
+
+	path := s.tmpl.Auth.TokenPath
+	if path == "" {
+		path = "access_token"
+	}
+	token := jsonString(payload, path)
+	if token == "" {
+		return "", errors.New("the token response has no token at ", path)
+	}
+
+	lifetime := int64(3600)
+	if s.tmpl.Auth.ExpiryPath != "" {
+		if n := jsonNumber(payload, s.tmpl.Auth.ExpiryPath); n > 0 {
+			lifetime = n
+		}
+	}
+	if lifetime > 60 {
+		lifetime -= 60
+	}
+	s.token = token
+	s.tokenExpiry = time.Now().Add(time.Duration(lifetime) * time.Second)
+	return s.token, nil
+}
+
+func (s *templateStorage) invalidateToken() {
+	s.tokenMu.Lock()
+	s.token = ""
+	s.tokenMu.Unlock()
+}
+
+func (s *templateStorage) do(ctx context.Context, op *opTemplate, vars map[string]string, body []byte) (int, []byte, error) {
+	backoff := driveInitialBackoff
+	var lastErr error
+
+	url := op.URL
+	if !op.presigned {
+		url = subst(url, vars)
+	}
+
+	for attempt := 0; attempt < driveMaxAttempts; attempt++ {
+		if attempt > 0 {
+			select {
+			case <-ctx.Done():
+				return 0, nil, ctx.Err()
+			case <-time.After(jitter(backoff)):
+			}
+			backoff *= 2
+			if backoff > driveMaxBackoff {
+				backoff = driveMaxBackoff
+			}
+		}
+
+		var authHeaders map[string]string
+		if !op.presigned {
+			headers, err := s.authHeaders(ctx, vars)
+			if err != nil {
+				lastErr = err
+				continue
+			}
+			authHeaders = headers
+		}
+
+		method := op.Method
+		if method == "" {
+			method = http.MethodGet
+		}
+
+		var reader io.Reader
+		if body != nil {
+			reader = bytes.NewReader(body)
+		}
+		req, err := http.NewRequestWithContext(ctx, method, url, reader)
+		if err != nil {
+			return 0, nil, errors.New("failed to build request").Base(err)
+		}
+		for k, v := range authHeaders {
+			req.Header.Set(k, v)
+		}
+		for k, v := range op.Headers {
+			req.Header.Set(k, subst(v, vars))
+		}
+
+		select {
+		case s.inflight <- struct{}{}:
+		case <-ctx.Done():
+			return 0, nil, ctx.Err()
+		}
+		resp, err := s.client.Do(req)
+		<-s.inflight
+		if err != nil {
+			if ctx.Err() != nil {
+				return 0, nil, ctx.Err()
+			}
+			lastErr = errors.New("request failed").Base(err)
+			continue
+		}
+		payload, err := io.ReadAll(resp.Body)
+		resp.Body.Close()
+		if err != nil {
+			if ctx.Err() != nil {
+				return 0, nil, ctx.Err()
+			}
+			lastErr = errors.New("failed to read response").Base(err)
+			continue
+		}
+
+		if resp.StatusCode == http.StatusUnauthorized && s.tmpl.Auth.Type == "oauth2" && !op.presigned {
+			s.invalidateToken()
+			lastErr = errors.New("the service rejected the token")
+			continue
+		}
+		if s.retryable(resp.StatusCode, payload) {
+			lastErr = errors.New("the service answered ", resp.StatusCode)
+			continue
+		}
+		return resp.StatusCode, payload, nil
+	}
+	return 0, nil, lastErr
+}
+
+// run performs op, following its href when the operation is two-step.
+func (s *templateStorage) run(ctx context.Context, op *opTemplate, vars map[string]string, body []byte) (int, []byte, error) {
+	if op.HrefPath == "" {
+		return s.do(ctx, op, vars, body)
+	}
+	status, payload, err := s.do(ctx, op, vars, nil)
+	if err != nil || status < 200 || status >= 300 {
+		return status, payload, err
+	}
+	href := jsonString(payload, op.HrefPath)
+	if href == "" {
+		return 0, nil, errors.New("the response has no href at ", op.HrefPath)
+	}
+	return s.do(ctx, &opTemplate{Method: op.HrefMethod, URL: href, presigned: true}, vars, body)
+}
+
+func (s *templateStorage) Put(ctx context.Context, name string, data []byte) error {
+	vars := s.baseVars()
+	vars["name"] = s.storedName(name)
+
+	body := data
+	if s.tmpl.Put.Body != "" {
+		vars["data"] = base64.StdEncoding.EncodeToString(data)
+		body = []byte(subst(s.tmpl.Put.Body, vars))
+	}
+
+	status, payload, err := s.run(ctx, &s.tmpl.Put, vars, body)
+	if err != nil {
+		return err
+	}
+	if status < 200 || status >= 300 {
+		return errors.New("put of ", name, " answered ", status, ": ", string(payload))
+	}
+	return nil
+}
+
+func (s *templateStorage) Get(ctx context.Context, name string) ([]byte, error) {
+	vars := s.baseVars()
+	vars["name"] = s.storedName(name)
+
+	status, payload, err := s.run(ctx, &s.tmpl.Get, vars, nil)
+	if err != nil {
+		return nil, err
+	}
+	switch {
+	case status >= 200 && status < 300:
+		return payload, nil
+	case status == http.StatusNotFound:
+		return nil, errNotFound
+	default:
+		return nil, errors.New("get of ", name, " answered ", status, ": ", string(payload))
+	}
+}
+
+func (s *templateStorage) Delete(ctx context.Context, name string) error {
+	vars := s.baseVars()
+	vars["name"] = s.storedName(name)
+
+	status, payload, err := s.run(ctx, &s.tmpl.Delete, vars, nil)
+	if err != nil {
+		return err
+	}
+	if status == http.StatusNotFound || (status >= 200 && status < 300) {
+		return nil
+	}
+	return errors.New("delete of ", name, " answered ", status, ": ", string(payload))
+}
+
+func (s *templateStorage) List(ctx context.Context, prefix string) ([]Entry, error) {
+	vars := s.baseVars()
+	flat := s.storedName(prefix)
+	vars["prefix"] = flat
+
+	status, payload, err := s.run(ctx, &s.tmpl.List, vars, nil)
+	if err != nil {
+		return nil, err
+	}
+	if status == http.StatusNotFound {
+		return nil, nil
+	}
+	if status < 200 || status >= 300 {
+		return nil, errors.New("list of ", prefix, " answered ", status, ": ", string(payload))
+	}
+
+	matches := s.tmpl.names.FindAllStringSubmatch(string(payload), -1)
+	if !s.tmpl.Flatten {
+		entries := make([]Entry, 0, len(matches))
+		for _, m := range matches {
+			entries = append(entries, Entry{Name: m[1]})
+		}
+		return entries, nil
+	}
+
+	want := flat + flatSeparator
+	seen := make(map[string]bool, len(matches))
+	entries := make([]Entry, 0, len(matches))
+	for _, m := range matches {
+		name := m[1]
+		if !strings.HasPrefix(name, want) {
+			continue
+		}
+		rest := strings.TrimPrefix(name, want)
+		if rest == "" {
+			continue
+		}
+		if cut := strings.Index(rest, flatSeparator); cut >= 0 {
+			rest = rest[:cut]
+		}
+		if seen[rest] {
+			continue
+		}
+		seen[rest] = true
+		entries = append(entries, Entry{Name: rest})
+	}
+	return entries, nil
+}
+
+func (s *templateStorage) Close() error {
+	if s.release != nil {
+		s.release()
+	}
+	return nil
+}
diff -ruN a/transport/internet/xdrive/wal.go pt/transport/internet/xdrive/wal.go
--- a/transport/internet/xdrive/wal.go	1970-01-01 00:00:00.000000000 +0000
+++ b/transport/internet/xdrive/wal.go	2026-11-24 19:03:30.394755610 +0000
@@ -0,0 +1,449 @@
+package xdrive
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/exclavenetwork/exclave-core/v5/common/errors"
+)
+
+const (
+	maxCoalescedTicks = 8
+
+	segSuffix = ".seg"
+	endSuffix = ".end"
+	errSuffix = ".err"
+)
+
+func objectName(prefix string, seq int64, suffix string) string {
+	return fmt.Sprintf("%s/%09d%s", prefix, seq, suffix)
+}
+
+func parseEntry(name string) (int64, bool) {
+	dot := strings.LastIndexByte(name, '.')
+	if dot < 0 {
+		return 0, false
+	}
+	switch name[dot:] {
+	case segSuffix, endSuffix, errSuffix:
+	default:
+		return 0, false
+	}
+	seq, err := strconv.ParseInt(name[:dot], 10, 64)
+	if err != nil || seq < 0 {
+		return 0, false
+	}
+	return seq, true
+}
+
+type walWriter struct {
+	ctx     context.Context
+	storage Storage
+	prefix  string
+	params
+	sem chan struct{}
+	wg  sync.WaitGroup
+
+	mu       sync.Mutex
+	buf      []byte
+	seq      int64
+	lastSize int
+	held     int
+	closed   bool
+	err      error
+}
+
+func newWALWriter(ctx context.Context, storage Storage, prefix string, p params) *walWriter {
+	w := &walWriter{
+		ctx:     ctx,
+		storage: storage,
+		prefix:  prefix,
+		params:  p,
+		sem:     make(chan struct{}, p.concurrency),
+	}
+	go w.flushLoop()
+	return w
+}
+
+func (w *walWriter) Write(p []byte) (int, error) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+
+	if w.err != nil {
+		return 0, w.err
+	}
+	if w.closed {
+		return 0, io.ErrClosedPipe
+	}
+
+	w.buf = append(w.buf, p...)
+	for len(w.buf) >= w.segmentBytes {
+		if err := w.flushLocked(); err != nil {
+			return 0, err
+		}
+	}
+	return len(p), nil
+}
+
+func (w *walWriter) flushLoop() {
+	ticker := time.NewTicker(w.flushInterval)
+	defer ticker.Stop()
+
+	for {
+		select {
+		case <-w.ctx.Done():
+			return
+		case <-ticker.C:
+			w.mu.Lock()
+			if !w.closed && w.err == nil && len(w.buf) > 0 && w.readyToFlush() {
+				w.flushLocked()
+			}
+			done := w.closed || w.err != nil
+			w.mu.Unlock()
+			if done {
+				return
+			}
+		}
+	}
+}
+
+func (w *walWriter) readyToFlush() bool {
+	grew := len(w.buf) > w.lastSize
+	w.lastSize = len(w.buf)
+
+	if grew && w.held < maxCoalescedTicks {
+		w.held++
+		return false
+	}
+	w.held = 0
+	return true
+}
+
+func (w *walWriter) flushLocked() error {
+	if len(w.buf) == 0 {
+		return nil
+	}
+	if w.err != nil {
+		return w.err
+	}
+
+	n := len(w.buf)
+	if n > w.segmentBytes {
+		n = w.segmentBytes
+	}
+
+	chunk := make([]byte, n)
+	copy(chunk, w.buf[:n])
+	seq := w.seq
+	w.seq++
+
+	if n == len(w.buf) {
+		w.buf = w.buf[:0]
+	} else {
+		w.buf = append(w.buf[:0], w.buf[n:]...)
+	}
+	w.lastSize = len(w.buf)
+	w.held = 0
+
+	w.wg.Add(1)
+	go w.upload(seq, chunk)
+	return nil
+}
+
+func (w *walWriter) upload(seq int64, chunk []byte) {
+	defer w.wg.Done()
+
+	select {
+	case w.sem <- struct{}{}:
+	case <-w.ctx.Done():
+		return
+	}
+	defer func() { <-w.sem }()
+
+	if err := w.storage.Put(w.ctx, objectName(w.prefix, seq, segSuffix), chunk); err != nil {
+		w.mu.Lock()
+		if w.err == nil {
+			w.err = errors.New("failed to store segment").Base(err)
+		}
+		w.mu.Unlock()
+		w.storage.Put(w.ctx, objectName(w.prefix, seq, errSuffix), nil)
+	}
+}
+
+func (w *walWriter) Close() error {
+	w.mu.Lock()
+	if w.closed {
+		w.mu.Unlock()
+		return nil
+	}
+	w.closed = true
+	for len(w.buf) > 0 && w.err == nil {
+		w.flushLocked()
+	}
+	w.mu.Unlock()
+
+	w.wg.Wait()
+
+	w.mu.Lock()
+	err, seq := w.err, w.seq
+	w.mu.Unlock()
+
+	if err != nil {
+		return err
+	}
+	return w.storage.Put(w.ctx, objectName(w.prefix, seq, endSuffix), nil)
+}
+
+type walReader struct {
+	ctx     context.Context
+	storage Storage
+	prefix  string
+	params
+	seq int64
+
+	ch        chan []byte
+	discards  chan string
+	wake      chan struct{}
+	holeSince time.Time
+
+	errMu sync.Mutex
+	err   error
+}
+
+func newWALReader(ctx context.Context, storage Storage, prefix string, p params) *walReader {
+	r := &walReader{
+		ctx:      ctx,
+		storage:  storage,
+		prefix:   prefix,
+		params:   p,
+		ch:       make(chan []byte, p.concurrency),
+		discards: make(chan string, 4*p.concurrency),
+		wake:     make(chan struct{}, 1),
+	}
+	go r.run()
+	go r.discardLoop()
+	return r
+}
+
+func (r *walReader) chunks() <-chan []byte {
+	return r.ch
+}
+
+func (r *walReader) Wake() {
+	select {
+	case r.wake <- struct{}{}:
+	default:
+	}
+}
+
+func (r *walReader) run() {
+	defer close(r.ch)
+
+	delay := r.minPollInterval
+	active := time.Now()
+	for {
+		polled := time.Now()
+		advanced, eof, err := r.poll()
+		if err != nil {
+			r.setErr(err)
+			return
+		}
+		if eof {
+			return
+		}
+
+		switch {
+		case advanced:
+			active = time.Now()
+			delay = r.minPollInterval
+		case time.Since(active) < r.eagerWindow:
+			delay = r.minPollInterval
+		default:
+			delay *= 2
+			if delay > r.maxPollInterval {
+				delay = r.maxPollInterval
+			}
+		}
+
+		timer := time.NewTimer(delay)
+		select {
+		case <-r.ctx.Done():
+			timer.Stop()
+			return
+		case <-timer.C:
+		case <-r.wake:
+			timer.Stop()
+			active = time.Now()
+			delay = r.minPollInterval
+			if rest := r.minPollInterval - time.Since(polled); rest > 0 {
+				select {
+				case <-r.ctx.Done():
+					return
+				case <-time.After(rest):
+				}
+			}
+		}
+	}
+}
+
+func (r *walReader) poll() (advanced, eof bool, err error) {
+	listed, err := r.storage.List(r.ctx, r.prefix)
+	if err != nil {
+		return false, false, err
+	}
+	if len(listed) == 0 {
+		return false, false, nil
+	}
+
+	pending := make(map[int64]Entry, len(listed))
+	ahead := false
+	for _, entry := range listed {
+		seq, ok := parseEntry(entry.Name)
+		if !ok {
+			continue
+		}
+		pending[seq] = entry
+		if seq > r.seq {
+			ahead = true
+		}
+	}
+
+	if _, ok := pending[r.seq]; !ok && ahead {
+		if r.holeSince.IsZero() {
+			r.holeSince = time.Now()
+		} else if time.Since(r.holeSince) >= r.holeTimeout {
+			return false, false, errors.New("segment ", r.seq,
+				" never arrived while later ones did, the peer lost it")
+		}
+	} else {
+		r.holeSince = time.Time{}
+	}
+
+	for {
+		if entry, ok := pending[r.seq]; ok && strings.HasSuffix(entry.Name, errSuffix) {
+			r.discard(r.prefix + "/" + entry.Name)
+			return advanced, false, errors.New("the peer could not store segment ", r.seq)
+		}
+
+		batch, done := r.nextBatch(pending)
+		if done {
+			return advanced, true, nil
+		}
+		if len(batch) == 0 {
+			return advanced, false, nil
+		}
+
+		chunks, err := r.fetch(batch)
+		if err != nil {
+			if err == errNotFound {
+				return advanced, false, nil
+			}
+			return advanced, false, err
+		}
+
+		for i, chunk := range chunks {
+			select {
+			case r.ch <- chunk:
+			case <-r.ctx.Done():
+				return advanced, true, nil
+			}
+			r.seq++
+			advanced = true
+			r.discard(r.prefix + "/" + batch[i].Name)
+		}
+	}
+}
+
+func (r *walReader) nextBatch(pending map[int64]Entry) (batch []Entry, done bool) {
+	for i := 0; i < r.concurrency; i++ {
+		entry, ok := pending[r.seq+int64(i)]
+		if !ok {
+			break
+		}
+		if !strings.HasSuffix(entry.Name, segSuffix) {
+			if i == 0 && strings.HasSuffix(entry.Name, endSuffix) {
+				r.discard(r.prefix + "/" + entry.Name)
+				return nil, true
+			}
+			break
+		}
+		batch = append(batch, entry)
+	}
+	return batch, false
+}
+
+func (r *walReader) fetch(batch []Entry) ([][]byte, error) {
+	chunks := make([][]byte, len(batch))
+	failures := make([]error, len(batch))
+
+	var wg sync.WaitGroup
+	for i, entry := range batch {
+		if entry.Inline != nil {
+			chunks[i] = entry.Inline
+			continue
+		}
+		wg.Add(1)
+		go func(i int, name string) {
+			defer wg.Done()
+			chunks[i], failures[i] = r.storage.Get(r.ctx, r.prefix+"/"+name)
+		}(i, entry.Name)
+	}
+	wg.Wait()
+
+	for i := range batch {
+		if failures[i] != nil {
+			return nil, failures[i]
+		}
+	}
+	return chunks, nil
+}
+
+func (r *walReader) discard(name string) {
+	select {
+	case r.discards <- name:
+	default:
+	}
+}
+
+func (r *walReader) discardLoop() {
+	var wg sync.WaitGroup
+	defer wg.Wait()
+
+	sem := make(chan struct{}, r.concurrency)
+	for {
+		select {
+		case <-r.ctx.Done():
+			return
+		case name := <-r.discards:
+			sem <- struct{}{}
+			wg.Add(1)
+			go func(name string) {
+				defer wg.Done()
+				defer func() { <-sem }()
+				r.storage.Delete(r.ctx, name)
+			}(name)
+		}
+	}
+}
+
+func (r *walReader) setErr(err error) {
+	r.errMu.Lock()
+	defer r.errMu.Unlock()
+	if r.err == nil {
+		r.err = err
+	}
+}
+
+func (r *walReader) Err() error {
+	r.errMu.Lock()
+	defer r.errMu.Unlock()
+	if r.err != nil {
+		return r.err
+	}
+	return io.EOF
+}
diff -ruN a/transport/internet/xdrive/xdrive.go pt/transport/internet/xdrive/xdrive.go
--- a/transport/internet/xdrive/xdrive.go	1970-01-01 00:00:00.000000000 +0000
+++ b/transport/internet/xdrive/xdrive.go	2026-11-24 19:03:48.682880695 +0000
@@ -0,0 +1,537 @@
+package xdrive
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/exclavenetwork/exclave-core/v5/common"
+	"github.com/exclavenetwork/exclave-core/v5/common/errors"
+	"github.com/exclavenetwork/exclave-core/v5/common/net"
+	"github.com/exclavenetwork/exclave-core/v5/transport/internet"
+	)
+
+const (
+	protocolName = "xdrive"
+	sessionsDir  = "sessions"
+	streamsDir   = "streams"
+	uplinkDir    = "c2s"
+	downlinkDir  = "s2c"
+)
+
+const (
+	spareCount    = 2
+	spareIdleStop = 10 * time.Minute
+)
+
+func init() {
+	common.Must(internet.RegisterProtocolConfigCreator(protocolName, func() interface{} {
+		return new(Config)
+	}))
+	common.Must(internet.RegisterTransportDialer(protocolName, Dial))
+	common.Must(internet.RegisterTransportListener(protocolName, Serve))
+}
+
+func newSessionID() (string, error) {
+	buf := make([]byte, 16)
+	if _, err := rand.Read(buf); err != nil {
+		return "", errors.New("failed to generate session id").Base(err)
+	}
+	return hex.EncodeToString(buf), nil
+}
+
+func announceName(session string, at time.Time) string {
+	return fmt.Sprintf("%s/%d-%s", sessionsDir, at.UnixNano(), session)
+}
+
+func parseAnnounce(entry string) (string, time.Time, bool) {
+	dash := strings.IndexByte(entry, '-')
+	if dash <= 0 || dash == len(entry)-1 {
+		return "", time.Time{}, false
+	}
+	nanos, err := strconv.ParseInt(entry[:dash], 10, 64)
+	if err != nil {
+		return "", time.Time{}, false
+	}
+	return entry[dash+1:], time.Unix(0, nanos), true
+}
+
+func sessionPrefix(session string) string {
+	return streamsDir + "/" + session
+}
+
+func uplinkPrefix(session string) string {
+	return sessionPrefix(session) + "/" + uplinkDir
+}
+
+func downlinkPrefix(session string) string {
+	return sessionPrefix(session) + "/" + downlinkDir
+}
+
+func streamConfig(streamSettings *internet.MemoryStreamConfig) (*Config, error) {
+	config, ok := streamSettings.ProtocolSettings.(*Config)
+	if !ok || config == nil {
+		return nil, errors.New("invalid protocol settings")
+	}
+	return config, nil
+}
+
+type spareRing struct {
+	storage Storage
+	session string
+	ring    ring
+	at      time.Time
+}
+
+type spareBox struct {
+	ch   chan spareRing
+	busy atomic.Bool
+	last atomic.Int64
+	stop atomic.Bool
+}
+
+var spareBoxes sync.Map
+
+func spareBoxFor(config *Config) *spareBox {
+	if b, ok := spareBoxes.Load(config); ok {
+		return b.(*spareBox)
+	}
+	b, _ := spareBoxes.LoadOrStore(config, &spareBox{ch: make(chan spareRing, spareCount)})
+	return b.(*spareBox)
+}
+
+func dropSpare(s spareRing) {
+	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+	defer cancel()
+	s.storage.Delete(ctx, sessionPrefix(s.session))
+	s.storage.Close()
+}
+
+func takeSpare(config *Config, p params) (spareRing, bool) {
+	box := spareBoxFor(config)
+	for {
+		select {
+		case s := <-box.ch:
+			if time.Since(s.at) < p.sessionTTL*2/3 {
+				return s, true
+			}
+			go dropSpare(s)
+		default:
+			return spareRing{}, false
+		}
+	}
+}
+
+func warmSpares(streamSettings *internet.MemoryStreamConfig, config *Config, p params) {
+	spareBoxFor(config).last.Store(time.Now().UnixNano())
+	fillSpares(streamSettings, config, p)
+}
+
+func fillSpares(streamSettings *internet.MemoryStreamConfig, config *Config, p params) {
+	box := spareBoxFor(config)
+	if !box.busy.CompareAndSwap(false, true) {
+		return
+	}
+	go func() {
+		defer box.busy.Store(false)
+		for n := len(box.ch); n > 0; n-- {
+			select {
+			case s := <-box.ch:
+				if time.Since(s.at) < p.sessionTTL/3 {
+					box.ch <- s
+				} else {
+					dropSpare(s)
+				}
+			default:
+			}
+		}
+		for len(box.ch) < cap(box.ch) {
+			for range 40 {
+				if box.stop.Load() {
+					return
+				}
+				time.Sleep(50 * time.Millisecond)
+			}
+			if box.stop.Load() {
+				return
+			}
+			storage, err := newStorage(streamSettings)
+			if err != nil {
+				return
+			}
+			storage = sessionStorage(storage)
+			slots, ok := storage.(slotStore)
+			if !ok {
+				storage.Close()
+				return
+			}
+			session, err := newSessionID()
+			if err != nil {
+				storage.Close()
+				return
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
+			r, err := makeRing(ctx, slots, session, p)
+			cancel()
+			if err != nil {
+				dropSpare(spareRing{storage: storage, session: session})
+				return
+			}
+			select {
+			case box.ch <- spareRing{storage: storage, session: session, ring: r, at: time.Now()}:
+			default:
+				storage.Close()
+				return
+			}
+		}
+		time.AfterFunc(p.sessionTTL/4, func() {
+			if !box.stop.Load() && time.Since(time.Unix(0, box.last.Load())) < spareIdleStop {
+				fillSpares(streamSettings, config, p)
+			}
+		})
+	}()
+}
+
+func Dial(ctx context.Context, dest net.Destination, streamSettings *internet.MemoryStreamConfig) (internet.Connection, error) {
+	config, err := streamConfig(streamSettings)
+	if err != nil {
+		return nil, err
+	}
+
+	p := paramsFromConfig(config)
+
+	spare, warm := takeSpare(config, p)
+	storage, session, r := spare.storage, spare.session, spare.ring
+	if !warm {
+		storage, err = newStorage(streamSettings)
+		if err != nil {
+			return nil, err
+		}
+		storage = sessionStorage(storage)
+
+		session, err = newSessionID()
+		if err != nil {
+			storage.Close()
+			return nil, err
+		}
+	}
+
+	p = paramsForStorage(config, storage)
+
+	slots, ok := storage.(slotStore)
+	if ok && !warm {
+		if r, err = makeRing(ctx, slots, session, p); err != nil {
+			ok = false
+			logWarningInner(ctx, err, "failed to make the slots of session ", session, ", it goes in segments")
+		}
+	}
+
+	if ok {
+		warmSpares(streamSettings, config, p)
+		logInfo(ctx, "opened session ", session, " in ", len(r.Up.Slots), " slots")
+		conn := newSlotConn(context.Background(), slots, r.Up, r.Down, p, nil, func() {
+			storage.Close()
+		})
+		writer := conn.writer.(*slotWriter)
+		writer.first = make(chan []byte, 1)
+		go func() {
+			var first []byte
+			select {
+			case first = <-writer.first:
+			case <-time.After(25 * time.Millisecond):
+			}
+			announce, _ := json.Marshal(r)
+			if len(first) > 0 && len(first) <= slotInlineLimit {
+				withFirst := r
+				withFirst.First = first
+				if encoded, err := json.Marshal(withFirst); err == nil && len(encoded) <= driveInlineLimit {
+					announce = encoded
+				}
+			}
+			// An announce failure surfaces as a connection error on the next Write/Read.
+			if err := storage.Put(context.Background(), announceName(session, time.Now()), announce); err != nil {
+				err = errors.New("failed to announce session ", session).Base(err)
+				writer.fail(err)
+				conn.reader.(*slotReader).setErr(err)
+			}
+		}()
+		return conn, nil
+	}
+
+	if err := storage.Put(ctx, announceName(session, time.Now()), nil); err != nil {
+		storage.Close()
+		return nil, errors.New("failed to announce session ", session).Base(err)
+	}
+	logInfo(ctx, "opened session ", session)
+	return newConn(context.Background(), storage,
+		uplinkPrefix(session), downlinkPrefix(session), p, func() {
+			storage.Close()
+		}), nil
+}
+
+type Listener struct {
+	ctx     context.Context
+	cancel  context.CancelFunc
+	storage Storage
+	addConn internet.ConnHandler
+	params
+
+	mu             sync.Mutex
+	active         map[string]bool
+	handled        map[string]time.Time
+	idleSince      map[string]time.Time
+	announceWarned map[string]bool
+	firstSeen      map[string]time.Time
+}
+
+func Serve(ctx context.Context, address net.Address, port net.Port, streamSettings *internet.MemoryStreamConfig, addConn internet.ConnHandler) (internet.Listener, error) {
+	config, err := streamConfig(streamSettings)
+	if err != nil {
+		return nil, err
+	}
+
+	storage, err := newStorage(streamSettings)
+	if err != nil {
+		return nil, err
+	}
+
+	listenerCtx, cancel := context.WithCancel(context.Background())
+	listener := &Listener{
+		ctx:            listenerCtx,
+		cancel:         cancel,
+		storage:        storage,
+		addConn:        addConn,
+		params:         paramsForStorage(config, storage),
+		active:         make(map[string]bool),
+		handled:        make(map[string]time.Time),
+		idleSince:      make(map[string]time.Time),
+		announceWarned: make(map[string]bool),
+		firstSeen:      make(map[string]time.Time),
+	}
+
+	go listener.acceptLoop(ctx)
+	go listener.collectLoop(ctx)
+
+	return listener, nil
+}
+
+func (l *Listener) acceptLoop(logCtx context.Context) {
+	delay := l.minPollInterval
+	active := time.Now()
+	for {
+		accepted, err := l.acceptPending(logCtx)
+		if err != nil && !isAuthError(err) {
+			logWarningInner(logCtx, err, "failed to list sessions")
+		}
+
+		switch {
+		case accepted:
+			active = time.Now()
+			delay = l.minPollInterval
+		case time.Since(active) < l.eagerWindow:
+			delay = l.minPollInterval
+		default:
+			delay *= 2
+			if delay > l.maxPollInterval {
+				delay = l.maxPollInterval
+			}
+		}
+
+		select {
+		case <-l.ctx.Done():
+			return
+		case <-time.After(delay):
+		}
+	}
+}
+
+func (l *Listener) acceptPending(logCtx context.Context) (bool, error) {
+	sessions, err := l.storage.List(l.ctx, sessionsDir)
+	if err != nil {
+		return false, err
+	}
+
+	accepted := false
+	l.mu.Lock()
+	if l.firstSeen == nil {
+		l.firstSeen = make(map[string]time.Time)
+	}
+	now := time.Now()
+	listedEntries := make(map[string]bool, len(sessions))
+	for _, listed := range sessions {
+		listedEntries[listed.Name] = true
+		if _, seen := l.firstSeen[listed.Name]; !seen {
+			l.firstSeen[listed.Name] = now
+		}
+	}
+	for entry := range l.firstSeen {
+		if !listedEntries[entry] {
+			delete(l.firstSeen, entry)
+		}
+	}
+	l.mu.Unlock()
+
+	for _, listed := range sessions {
+		entry := listed.Name
+		full := sessionsDir + "/" + entry
+
+		session, _, ok := parseAnnounce(entry)
+		if !ok {
+			go l.drop(full)
+			continue
+		}
+		l.mu.Lock()
+		age := now.Sub(l.firstSeen[entry])
+		l.mu.Unlock()
+		if age > l.sessionTTL {
+			logInfo(logCtx, "dropping the stale announcement of session ", session)
+			go l.drop(full)
+			l.mu.Lock()
+			protected := l.active[session] || !l.handled[session].IsZero()
+			l.mu.Unlock()
+			if !protected {
+				go l.drop(sessionPrefix(session))
+			}
+			continue
+		}
+		if !l.claim(session) {
+			continue
+		}
+		announce := listed.Inline
+		if len(announce) == 0 {
+			if _, ok := sessionStorage(l.storage).(slotStore); ok {
+				announce, err = l.storage.Get(context.WithValue(l.ctx, maxBodyKey{}, int64(driveMaxAnnounce)), full)
+				if err != nil {
+					l.mu.Lock()
+					delete(l.active, session)
+					delete(l.handled, session)
+					warn := !l.announceWarned[session]
+					l.announceWarned[session] = true
+					l.mu.Unlock()
+					if warn {
+						logWarningInner(logCtx, err, "failed to read the announcement of session ", session)
+					}
+					continue
+				}
+			}
+		}
+		go l.drop(full)
+		accepted = true
+		l.addConn(l.newSessionConn(logCtx, session, announce))
+	}
+	return accepted, nil
+}
+
+func (l *Listener) drop(name string) {
+	l.storage.Delete(l.ctx, name)
+}
+
+func (l *Listener) claim(session string) bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.active[session] || !l.handled[session].IsZero() {
+		return false
+	}
+	l.active[session] = true
+	l.handled[session] = time.Now()
+	return true
+}
+
+// newSessionConn takes a session in the slots that its announcement has, or
+// in segments if it has none
+func (l *Listener) newSessionConn(logCtx context.Context, session string, announce []byte) *Conn {
+	storage := sessionStorage(l.storage)
+	onClose := func() {
+		storage.Close()
+		l.mu.Lock()
+		delete(l.active, session)
+		l.mu.Unlock()
+	}
+	if slots, ok := storage.(slotStore); ok {
+		if r, ok := decodeRing(announce); ok {
+			logInfo(logCtx, "accepted session ", session, " in ", len(r.Down.Slots), " slots")
+			return newSlotConn(l.ctx, slots, r.Down, r.Up, l.params, r.First, onClose)
+		}
+	}
+	logInfo(logCtx, "accepted session ", session)
+	return newConn(l.ctx, storage, downlinkPrefix(session), uplinkPrefix(session), l.params, onClose)
+}
+
+func (l *Listener) collectLoop(logCtx context.Context) {
+	interval := l.sessionTTL / 2
+	for {
+		select {
+		case <-l.ctx.Done():
+			return
+		case <-time.After(interval):
+		}
+		if err := l.collect(); err != nil {
+			logWarningInner(logCtx, err, "failed to collect abandoned sessions")
+		}
+	}
+}
+
+func (l *Listener) collect() error {
+	sessions, err := l.storage.List(l.ctx, streamsDir)
+	if err != nil {
+		return err
+	}
+
+	now := time.Now()
+	var expired []string
+
+	l.mu.Lock()
+	present := make(map[string]bool, len(sessions))
+	for _, listed := range sessions {
+		session := listed.Name
+		present[session] = true
+		if l.active[session] {
+			delete(l.idleSince, session)
+			continue
+		}
+		since, seen := l.idleSince[session]
+		if !seen {
+			l.idleSince[session] = now
+			continue
+		}
+		if now.Sub(since) >= l.sessionTTL {
+			expired = append(expired, session)
+			delete(l.idleSince, session)
+		}
+	}
+	for session := range l.idleSince {
+		if !present[session] {
+			delete(l.idleSince, session)
+		}
+	}
+	for session, at := range l.handled {
+		if !l.active[session] && now.Sub(at) >= l.sessionTTL {
+			delete(l.handled, session)
+		}
+	}
+	l.mu.Unlock()
+
+	var first error
+	for _, session := range expired {
+		if err := l.storage.Delete(l.ctx, sessionPrefix(session)); err != nil && first == nil {
+			first = err
+		}
+	}
+	return first
+}
+
+func (l *Listener) Addr() net.Addr {
+	return placeholderAddr
+}
+
+func (l *Listener) Close() error {
+	l.cancel()
+	return l.storage.Close()
+}
diff -ruN a/transport/internet/xdrive/xdrive_shim.go pt/transport/internet/xdrive/xdrive_shim.go
--- a/transport/internet/xdrive/xdrive_shim.go	1970-01-01 00:00:00.000000000 +0000
+++ b/transport/internet/xdrive/xdrive_shim.go	2026-11-24 19:04:58.315359156 +0000
@@ -0,0 +1,58 @@
+package xdrive
+
+// NextClave (NC_XDRIVE): compatibility shims for the Exclave fork of Xray-core.
+//
+// The XDRIVE transport was ported from Xray-core v26.11.9
+// (transport/internet/xdrive, PRs XTLS/Xray-core#5645 and #6748) into the
+// ExclaveNetwork/exclave-core tree, which forked before the upstream
+// refactorings. This file carries the pieces of that port that had to be
+// adapted; every other change of the port is a mechanical import-path
+// rewrite:
+//
+//   - upstream's context-aware logging helpers (errors.LogInfo etc.) do not
+//     exist in the fork (its common/errors only has the builder API), so the
+//     calls are rewritten to these shims;
+//   - upstream keeps per-stream QUIC tuning (sockopt-level QuicParams,
+//     FinalMask dialing, "fronting" Destination) on MemoryStreamConfig; the
+//     fork's MemoryStreamConfig has none of those fields, so the h3 dialer
+//     runs with quic-go defaults, keeps the Chrome-parrot connection id
+//     behavior (the fork's quic-go always builds it) and applies the standard
+//     BBR profile, and always dials through internet.DialSystem;
+//   - upstream's net.ConnIdleTimeout / net.ChromeH2KeepAlivePeriod constants
+//     are not in the fork's common/net, so the values upstream uses are
+//     pinned here.
+
+import (
+	"context"
+	"time"
+
+	"github.com/exclavenetwork/exclave-core/v5/common/errors"
+	"github.com/exclavenetwork/exclave-core/v5/common/session"
+)
+
+const (
+	connIdleTimeout = 300 * time.Second
+	// consistent with chrome
+	chromeH2KeepAlivePeriod = 45 * time.Second
+)
+
+func logDebug(ctx context.Context, v ...interface{}) {
+	errors.New(v...).AtDebug().WriteToLog(session.ExportIDToError(ctx))
+}
+
+func logInfo(ctx context.Context, v ...interface{}) {
+	errors.New(v...).AtInfo().WriteToLog(session.ExportIDToError(ctx))
+}
+
+func logWarning(ctx context.Context, v ...interface{}) {
+	errors.New(v...).AtWarning().WriteToLog(session.ExportIDToError(ctx))
+}
+
+func logError(ctx context.Context, v ...interface{}) {
+	errors.New(v...).AtError().WriteToLog(session.ExportIDToError(ctx))
+}
+
+// logWarningInner logs v at warning severity with inner as the wrapped cause.
+func logWarningInner(ctx context.Context, inner error, v ...interface{}) {
+	errors.New(v...).AtWarning().Base(inner).WriteToLog(session.ExportIDToError(ctx))
+}
