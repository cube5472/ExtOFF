diff -ruN a/infra/conf/v4/xdrive.go pt/infra/conf/v4/xdrive.go
--- a/infra/conf/v4/xdrive.go	1970-01-01 00:00:00.000000000 +0000
+++ b/infra/conf/v4/xdrive.go	2026-11-24 19:15:57.691836435 +0000
@@ -0,0 +1,195 @@
+package v4
+
+// NextClave (NC_XDRIVE): XDRIVE transport configuration, ported from
+// Xray-core v26.11.9 (infra/conf/transport_method.go + infra/conf/xray.go,
+// PRs XTLS/Xray-core#5645 and #6748) to the Exclave fork's v4 config layout:
+//   - the fork's splithttp.XmuxConfig proto carries plain strings instead of
+//     typed ranges, so the xmux defaults are written in the fork's range
+//     string format ("1", "4", "1800-3000");
+//   - the fork's vless Account proto has no "testpre"/"reverse" fields, so
+//     those upstream checks are dropped;
+//   - the fork's proxyman.MultiplexingConfig has no xudp fields, so the mux
+//     requirement only checks Enabled (its Concurrency is unsigned anyway);
+//   - the fork's vless outbound carries its accounts through
+//     protocol.ServerEndpoint.User instead of the upstream Vnext.User chain.
+
+import (
+	"encoding/json"
+
+	"github.com/exclavenetwork/exclave-core/v5/app/proxyman"
+	"github.com/exclavenetwork/exclave-core/v5/common/net"
+	"github.com/exclavenetwork/exclave-core/v5/proxy/vless"
+	vless_inbound "github.com/exclavenetwork/exclave-core/v5/proxy/vless/inbound"
+	vless_outbound "github.com/exclavenetwork/exclave-core/v5/proxy/vless/outbound"
+	"github.com/exclavenetwork/exclave-core/v5/transport/internet"
+	"github.com/exclavenetwork/exclave-core/v5/transport/internet/splithttp"
+	"github.com/exclavenetwork/exclave-core/v5/transport/internet/xdrive"
+	"github.com/golang/protobuf/proto"
+)
+
+type XDriveConfig struct {
+	RemoteFolder      string          `json:"remoteFolder"`
+	Service           string          `json:"service"`
+	Secrets           []string        `json:"secrets"`
+	SegmentBytes      uint32          `json:"segmentBytes"`
+	FlushIntervalMs   uint32          `json:"flushIntervalMs"`
+	PollIntervalMs    uint32          `json:"pollIntervalMs"`
+	MaxPollIntervalMs uint32          `json:"maxPollIntervalMs"`
+	SessionTTLSeconds uint32          `json:"sessionTtlSeconds"`
+	Concurrency       uint32          `json:"concurrency"`
+	EagerWindowMs     uint32          `json:"eagerWindowMs"`
+	HoleTimeoutMs     uint32          `json:"holeTimeoutMs"`
+	Template          json.RawMessage `json:"template"`
+	S3                *XDriveS3Config `json:"s3"`
+	Xmux              XmuxConfig      `json:"xmux"`
+
+	// set by StreamConfig when "alpn" is ["h3"]
+	h3 bool
+}
+
+type XDriveS3Config struct {
+	Endpoint  string `json:"endpoint"`
+	Region    string `json:"region"`
+	Bucket    string `json:"bucket"`
+	PathStyle *bool  `json:"pathStyle"`
+}
+
+// Build implements Buildable.
+func (c *XDriveConfig) Build() (proto.Message, error) {
+	switch c.Service {
+	case "local":
+	case "Google Drive":
+		// deprecated spelling, normalized like upstream does
+		c.Service = "google-drive"
+		fallthrough
+	case "google-drive":
+		if len(c.Secrets) != 3 {
+			return nil, newError("Google Drive needs 3 secrets in order of ClientID, ClientSecret, RefreshToken")
+		}
+	case "template":
+		if len(c.Template) == 0 {
+			return nil, newError(`service "template" needs a "template" object`)
+		}
+	case "s3":
+		if c.S3 == nil {
+			return nil, newError(`service "s3" needs an "s3" object`)
+		}
+	default:
+		return nil, newError(`unknown "service": "`, c.Service, `", use "google-drive", "template", "s3" or "local"`)
+	}
+	if c.Xmux.MaxConnections != "" && c.Xmux.MaxConcurrency != "" {
+		return nil, newError("maxConnections cannot be specified together with maxConcurrency")
+	}
+	if c.Xmux == (XmuxConfig{}) {
+		// NC_XDRIVE: the upstream defaults, written in the fork's range
+		// string format. Google gives an h2 connection 1 MiB of window, which
+		// a few sessions on a long rtt would share; an h3 connection has no
+		// such limit, so google-drive over h2 widens the pool to 4.
+		if c.Service == "google-drive" && !c.h3 {
+			c.Xmux.MaxConnections = "4"
+		} else {
+			c.Xmux.MaxConnections = "1"
+		}
+		c.Xmux.HMaxReusableSecs = "1800-3000"
+	}
+	config := &xdrive.Config{
+		RemoteFolder:      c.RemoteFolder,
+		Service:           c.Service,
+		Secrets:           c.Secrets,
+		SegmentBytes:      c.SegmentBytes,
+		FlushIntervalMs:   c.FlushIntervalMs,
+		PollIntervalMs:    c.PollIntervalMs,
+		MaxPollIntervalMs: c.MaxPollIntervalMs,
+		SessionTtlSeconds: c.SessionTTLSeconds,
+		Concurrency:       c.Concurrency,
+		EagerWindowMs:     c.EagerWindowMs,
+		HoleTimeoutMs:     c.HoleTimeoutMs,
+		Template:          string(c.Template),
+		Xmux:              xdriveXmuxFromConf(&c.Xmux),
+	}
+	if c.Service == "s3" {
+		config.S3 = &xdrive.S3Config{
+			Endpoint:  c.S3.Endpoint,
+			Region:    c.S3.Region,
+			Bucket:    c.S3.Bucket,
+			PathStyle: c.S3.PathStyle == nil || *c.S3.PathStyle,
+		}
+		if err := xdrive.ValidateS3Config(config); err != nil {
+			return nil, err
+		}
+	}
+	return config, nil
+}
+
+// validateXDrive allows only VLESS with encryption on xdrive, and on the
+// client Mux for every connection.
+func validateXDrive(ts proto.Message, ss *internet.StreamConfig, ms *proxyman.MultiplexingConfig, pr *net.PortRange) error {
+	if ss == nil || ss.ProtocolName != "xdrive" {
+		return nil
+	}
+	switch c := ts.(type) {
+	case *vless_outbound.Config:
+		for _, ep := range c.Vnext {
+			if ep == nil {
+				continue
+			}
+			for _, u := range ep.User {
+				if u == nil || u.Account == nil {
+					continue
+				}
+				// NC_XDRIVE: the fork carries accounts as *anypb.Any
+				account := &vless.Account{}
+				if err := u.Account.UnmarshalTo(account); err != nil {
+					return newError("failed to unmarshal the VLESS account").Base(err)
+				}
+				if account.Flow != "" {
+					return newError(`the xdrive transport doesn't support VLESS "flow"`)
+				}
+				if account.Encryption == "none" || account.Encryption == "" {
+					return newError(`the xdrive transport needs VLESS "encryption", run "xray vlessenc" to get one`)
+				}
+			}
+		}
+		// NC_XDRIVE: the fork's MultiplexingConfig has no xudp knobs and its
+		// Concurrency is unsigned, so only the switch matters here.
+		if ms == nil || !ms.Enabled {
+			return newError(`the xdrive transport needs "mux" enabled`)
+		}
+	case *vless_inbound.Config:
+		if c.Decryption == "none" || c.Decryption == "" {
+			return newError(`the xdrive transport needs VLESS "decryption", run "xray vlessenc" to get one`)
+		}
+		for _, user := range c.Clients {
+			if user == nil || user.Account == nil {
+				continue
+			}
+			// NC_XDRIVE: the fork carries accounts as *anypb.Any
+			account := &vless.Account{}
+			if err := user.Account.UnmarshalTo(account); err != nil {
+				return newError("failed to unmarshal the VLESS account").Base(err)
+			}
+			if account.Flow != "" {
+				return newError(`the xdrive transport doesn't support VLESS "flow"`)
+			}
+		}
+		// every port gets its own listener on the same folder, and each of
+		// them accepts the same session. NC_XDRIVE: the fork's ReceiverConfig
+		// carries a PortRange instead of upstream's PortList.
+		if pr != nil && pr.From != pr.To {
+			return newError("the xdrive transport can only listen on one port")
+		}
+	default:
+		return newError("the xdrive transport can only be used by VLESS")
+	}
+	return nil
+}
+
+func xdriveXmuxFromConf(c *XmuxConfig) *splithttp.XmuxConfig {
+	return &splithttp.XmuxConfig{
+		MaxConcurrency:   c.MaxConcurrency,
+		MaxConnections:   c.MaxConnections,
+		CMaxReuseTimes:   c.CMaxReuseTimes,
+		HMaxRequestTimes: c.HMaxRequestTimes,
+		HMaxReusableSecs: c.HMaxReusableSecs,
+	}
+}
