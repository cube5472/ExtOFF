 	return nil
 }
+
+// setSocketTTL sets a temporary TTL on the socket and returns a restore
+// function. Used by the "disorder" mode to send the first ClientHello fragment
+// with a TTL that expires before it reaches any DPI system.
+func setSocketTTL(conn *net.TCPConn, ttl int) (restore func(), ok bool) {
+	rawConn, err := conn.SyscallConn()
+	if err != nil {
+		return nil, false
+	}
+	defTTL := -1
+	var level, option int
+	var setErr error
+	rawConn.Control(func(fd uintptr) {
+		level, option = unix.IPPROTO_IP, unix.IP_TTL
+		if sa, err := unix.Getsockname(int(fd)); err == nil {
+			if _, is6 := sa.(*unix.SockaddrInet6); is6 {
+				level, option = unix.IPPROTO_IPV6, unix.IPV6_UNICAST_HOPS
+			}
+		}
+		v, err := unix.GetsockoptInt(int(fd), level, option)
+		if err != nil {
+			setErr = err
+			return
+		}
+		defTTL = v
+		setErr = unix.SetsockoptInt(int(fd), level, option, ttl)
+	})
+	if setErr != nil || defTTL < 0 {
+		return nil, false
+	}
+	return func() {
+		rawConn.Control(func(fd uintptr) {
+			_ = unix.SetsockoptInt(int(fd), level, option, defTTL)
+		})
+	}, true
+}
