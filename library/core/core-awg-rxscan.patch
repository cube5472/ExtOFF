+	// NextClave (NC_AWG) fix(26f): padding sweep fallback. AWG requires the
+	// S1-S4 padding values to be identical on both peers; when the peer's
+	// config drifts (the provider changed the server-side values while client
+	// profiles keep the old ones), every genuine inbound packet dies as
+	// "Received message with unknown type" because the type word sits at the
+	// sender's padding offset instead of our configured one. The header
+	// protection keystream is padding-independent - the type word is always
+	// XORed with keystream bytes 0-3 and the rest of the header with bytes
+	// 4-... - so candidate offsets can be scanned safely. Upstream behavior
+	// (exact configured offset with its size gates) is fully preserved above;
+	// the sweep only runs when nothing matched. For handshake kinds the found
+	// padding is adopted for our own TX of the same kind (the same parameter
+	// governs the peer's RX of our packets); the transport padding is adopted
+	// only from packets whose receiver index matched a live keypair (see the
+	// transport case in RoutineReceiveIncoming), so junk datagrams can never
+	// poison it.
+	for _, k := range []struct {
+		name   string
+		pad    *atomic.Uint32
+		header UintRange
+		ksize  int
+		kind   uint32
+	}{
+		{"init", &device.paddings.init, device.headers.init.Load(), MessageInitiationSize, MessageInitiationType},
+		{"response", &device.paddings.response, device.headers.response.Load(), MessageResponseSize, MessageResponseType},
+		{"cookie", &device.paddings.cookie, device.headers.cookie.Load(), MessageCookieReplySize, MessageCookieReplyType},
+		{"transport", &device.paddings.transport, device.headers.transport.Load(), MessageTransportSize, MessageTransportType},
+	} {
+		limit := size - k.ksize
+		if limit < 0 {
+			continue // datagram too small for this kind
+		}
+		if limit > ncRxScanMaxPadding {
+			limit = ncRxScanMaxPadding
+		}
+		for o := 0; o <= limit; o++ {
+			if uint32(o) == k.pad.Load() {
+				continue // exact offset already checked above
+			}
+			applyHash(headerBytes[:], packet[o:o+4], typeHash)
+			if !k.header.Contains(binary.LittleEndian.Uint32(headerBytes[:])) {
+				continue
+			}
+			// NextClave (NC_AWG) dbg26e: the peer's real padding for this
+			// kind surfaced - log it and, for handshake kinds, adopt it for
+			// our own TX (bounded).
+			if ncDbg26eAllow(8, 24) {
+				device.log.Errorf("NC_AWG dbg26e verdict FOUND kind=%s off=%d configured=%d size=%d kindSize=%d", k.name, o, k.pad.Load(), size, k.ksize)
+			}
+			if k.kind != MessageTransportType {
+				k.pad.Store(uint32(o))
+			}
+			return k.ksize, k.kind, uint32(o)
+		}
+	}
