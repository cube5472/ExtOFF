<?xml version="1.0" encoding="utf-8"?>
<!-- NextClave: rounded badge behind the "/" glyph of the drawer header.
     A ripple layer is wrapped around the same shape - the badge is now
     tappable (it opens the "about" screen), so presses need feedback. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#3DFFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#14FFFFFF" />
        </shape>
    </item>
</ripple>
