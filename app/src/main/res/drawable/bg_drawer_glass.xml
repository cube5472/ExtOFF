<?xml version="1.0" encoding="utf-8"?>
<!-- NextClave: glass navigation drawer background (light theme).
     Translucent vertical glass gradient, all corners rounded (the panel now
     floats in from the screen edge like the approved preview) with a hairline
     contour. The accent rim on the right edge is a separate view painted by
     MainActivity so it always follows the selected Coal accent color. The
     blur behind the panel is applied by MainActivity via RenderEffect on
     Android 12+; older versions keep the plain scrim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#D9F4F5F7"
                android:endColor="#C8E9ECEF" />
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#1F808080" />
        </shape>
    </item>
</layer-list>
