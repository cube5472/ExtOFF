<?xml version="1.0" encoding="utf-8"?>
<!-- NextClave: glass navigation drawer background. Translucent surface with
     rounded right corners (see drawerGlassColor theme attribute); the actual
     blur behind it is applied by MainActivity via RenderEffect on Android 12+,
     lower versions get the plain translucent scrim. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/drawerGlassColor" />
    <corners
        android:topRightRadius="26dp"
        android:bottomRightRadius="26dp" />
    <stroke
        android:width="1dp"
        android:color="#14808080" />
</shape>
