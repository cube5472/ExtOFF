<?xml version="1.0" encoding="utf-8"?>
<!-- NextClave: glass navigation drawer background (light theme).
     Layer 1: translucent vertical glass gradient with rounded right corners
     and a hairline contour; layer 2: the Coal rim - the accent gradient line
     hugging the right edge (Coal Pink -> Coal Turquoise), same as the
     approved preview. The blur behind the panel is applied by MainActivity
     via RenderEffect on Android 12+; older versions keep the plain scrim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#D9F4F5F7"
                android:endColor="#C8E9ECEF" />
            <corners
                android:topRightRadius="26dp"
                android:bottomRightRadius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#1F808080" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:gravity="right">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#C11D5E"
                android:endColor="#35705E" />
            <corners
                android:topRightRadius="26dp"
                android:bottomRightRadius="26dp" />
        </shape>
    </item>
</layer-list>
