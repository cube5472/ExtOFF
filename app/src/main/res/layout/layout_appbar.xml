<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.AppBarLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appbar"
    android:background="@drawable/bg_appbar_border"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:elevation="4dp">

    <!-- NextClave: the connections button must be a SIBLING of the toolbar,
         not a child of it. androidx Toolbar lays out custom children with its
         own internal cursor and does not honor marginStart the way
         FrameLayout does, which made the button land exactly on top of the
         url-test menu item. As a sibling overlay the 58dp start margin is
         deterministic: just right of the hamburger, well left of the menu
         block (which starts at >= 104dp on 360dp screens). -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_appbar_border"
            android:theme="?actionBarTheme"
            android:touchscreenBlocksFocus="false"
            app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
            app:title="@string/app_name">

        </com.google.android.material.appbar.MaterialToolbar>

        <!-- NextClave: live connections ("Requests") button. Shown only on the
             main profile screen (ConfigurationFragment, non-select mode) in
             place of the app-name title, which was truncated to "N…" anyway. -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/toolbar_connections"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="58dp"
            android:background="?attr/actionBarItemBackground"
            android:contentDescription="@string/connections"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_connections"
            android:visibility="gone" />

    </FrameLayout>
</com.google.android.material.appbar.AppBarLayout>
