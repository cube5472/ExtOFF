<?xml version="1.0" encoding="utf-8"?>
<!-- NextClave: one connection row in the "Requests" viewer -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="false"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <ImageView
            android:id="@+id/badge"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_conn_badge"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_connections"
            android:tint="#FFFFFFFF" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/destination"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceSubtitle2"
                android:textColor="?whiteOrTextPrimary"
                tools:text="tcp://149.154.167.4:443" />

            <TextView
                android:id="@+id/when_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="?android:textColorSecondary"
                tools:text="Только что" />
        </LinearLayout>

        <TextView
            android:id="@+id/app_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceBody2"
            android:textColor="?android:textColorSecondary"
            tools:text="ua.entaytion.entinygram" />

        <LinearLayout
            android:id="@+id/chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="start"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_outbound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_conn_chip"
                android:ellipsize="end"
                android:maxWidth="220dp"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="?whiteOrTextPrimary"
                tools:text="anytls-58686" />

            <TextView
                android:id="@+id/chip_proto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_conn_chip"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:singleLine="true"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="?android:textColorSecondary"
                tools:text="TCP" />

            <TextView
                android:id="@+id/chip_dns"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_conn_chip"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:singleLine="true"
                android:text="DNS"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="?android:textColorSecondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/chip_blocked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_conn_chip_red"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:singleLine="true"
                android:text="@string/connections_blocked"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="#E53947"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
