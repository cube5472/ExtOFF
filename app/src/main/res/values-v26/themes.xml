<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SagerNet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="actionBarStyle">@style/Widget.MaterialComponents.ActionBar.Solid</item>
        <item name="actionModeCloseDrawable">@drawable/ic_navigation_close</item>
        <item name="colorButtonNormal">?colorAccent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/material_pink_500</item>
        <item name="colorPrimaryDark">@color/material_pink_700</item>
        <item name="colorAccent">@color/material_pink_accent_200</item>
        <item name="colorMaterial100">@color/material_pink_100</item>
        <item name="colorMaterial300">@color/material_pink_300</item>
        <item name="accentOrTextSecondary">?colorAccent</item>
        <item name="accentOrTextPrimary">?colorAccent</item>
        <item name="primaryOrTextSecondary">?colorPrimary</item>
        <item name="primaryOrTextPrimary">?colorPrimary</item>
        <item name="fabColorBackground">?colorPrimary</item>
        <item name="selectedColorPrimary">?colorPrimary</item>
        <item name="actionBarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="tabTextColor">#99FFFFFF</item>
        <item name="tabSelectedTextColor">@color/white</item>
        <item name="tabIndicatorColor">@color/white</item>
        <item name="tabRippleColor">@color/white</item>
        <item name="whiteOrTextPrimary">@color/white</item>
        <item name="windowActionModeOverlay">true</item>
        <!-- Remove ActionBar but keep styles and themes -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="chipStyle">@style/Widget.MaterialComponents.Chip.Choice.SagerNet</item>
        <item name="itemShapeAppearance">
            @style/ShapeAppearance.MaterialComponents.MediumComponent
        </item>
        <item name="alertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>
        <item name="materialAlertDialogTheme">
            @style/ThemeOverlay.MaterialComponents.MaterialAlertDialog.SagerNet
        </item>
        <item name="coalAppBarColor">?colorPrimary</item>
        <item name="coalBorderColor">@android:color/transparent</item>

        <!-- NextClave: glass menu popups unified with the glass drawer.
             v26 copy of Theme.SagerNet MUST repeat these: resource config
             buckets do not merge styles, so on Android 8+ THIS file is the
             applied base theme, and the default-bucket items never resolve.
             actionOverflowMenuStyle covers the toolbar overflow menu AND the
             add-profile action popup (appcompat routes both through it);
             popupMenuStyle covers every nested submenu level and the
             per-item PopupMenus; listPopupWindowStyle covers plain
             ListPopupWindow dropdowns. The toolbar popupTheme overlay
             (ThemeOverlay.AppCompat.DayNight) sets no popup attributes, so
             these resolve through it unchanged. Dialog themes derive from
             Theme.SagerNet.Dialog (defined in the default bucket only), so
             they inherit these attributes from here too. -->
        <item name="popupMenuStyle">@style/Widget.NextClave.PopupMenu.Glass</item>
        <item name="actionOverflowMenuStyle">@style/Widget.NextClave.PopupMenu.Overflow.Glass</item>
        <item name="listPopupWindowStyle">@style/Widget.NextClave.ListPopupWindow.Glass</item>
    </style>
</resources>