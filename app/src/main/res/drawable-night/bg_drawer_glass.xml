<?xml version="1.0" encoding="utf-8"?>
<!-- NextClave: glass navigation drawer background (dark theme) - pixel-matched
     to the approved preview: vertical gradient rgba(17,22,19,.80) over
     rgba(9,11,10,.68), all corners rounded (the panel floats in from the
     screen edge), hairline contour. The accent rim on the right edge is a
     separate view painted by MainActivity so it always follows the selected
     Coal accent color. Blur is applied by MainActivity via RenderEffect on
     Android 12+. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#CC111613"
                android:endColor="#AD090B0A" />
            <corners android:radius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#14808080" />
        </shape>
    </item>
</layer-list>
