<?xml version="1.0" encoding="utf-8"?>
<!-- NextClave: glass navigation drawer background (dark theme) - pixel-matched
     to the approved preview: vertical gradient rgba(17,22,19,.80) over
     rgba(9,11,10,.68), right corners 26dp, hairline contour, and the Coal rim
     accent line on the right edge (Coal Pink #C11D5E -> Coal Turquoise
     #35705E). Blur is applied by MainActivity via RenderEffect on Android 12+. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#CC111613"
                android:endColor="#AD090B0A" />
            <corners
                android:topRightRadius="26dp"
                android:bottomRightRadius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#14808080" />
        </shape>
    </item>
    <item
        android:width="3dp"
        android:gravity="right">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#C11D5E"
                android:endColor="#35705E" />
            <corners
                android:topRightRadius="26dp"
                android:bottomRightRadius="26dp" />
        </shape>
    </item>
</layer-list>
