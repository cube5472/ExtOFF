<?xml version="1.0" encoding="utf-8"?>
<!-- NextClave: glass background for toolbar menu popups (dark theme) -
     pixel-matched to the dark glass drawer (rgba(17,22,19,.80) over
     rgba(9,11,10,.68)) so the overflow menu, the add-profile popup and
     every nested submenu level read as the same material as the sidebar.
     Padding mirrors the stock popup 9-patch (16dp start, 8dp vertical). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#CC111613"
        android:endColor="#AD090B0A" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="#14808080" />
    <padding
        android:left="16dp"
        android:top="8dp"
        android:right="0dp"
        android:bottom="8dp" />
</shape>
